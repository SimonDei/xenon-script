package {
  // The standard library: members of built-in types come from native declarations
  // in the prelude (src/prelude/std), available in every file without an import.
  public class Main {
    public function Main() {
      booleans()
      json()
      objects()
      numbers()
      integers()
      logging()
      maths()
      dates()
      sets()
      iterators()
      regexps()
      maps()
      strings()
      arrays()
      globals()
    }

    private function globals():void {
      // the global functions are typed: encoding, Base64 and deep copies
      trace(encodeURIComponent('a b&c'), decodeURIComponent('%C3%A4'), encodeURI('/a b?q=1'), btoa('xenon'), atob('eGVub24='))
      var original:Array<Array<int>> = [[1, 2], [3]]
      var copy:Array<Array<int>> = structuredClone(original)
      copy[0].push(9)
      trace(original[0].join(','), copy[0].join(','))

      // timers run after this constructor; their handles are untyped (`*`)
      var cancelled:* = setTimeout(() => trace('never printed'), 1)
      clearTimeout(cancelled)
      queueMicrotask(() => trace('microtask: before any timer'))
      setTimeout(async () => {
        var later:int = await Promise.resolve(3)
        trace('timeout, async callback:', later)
      }, 5)
    }

    private function booleans():void {
      var ready:Boolean = 3 > 2
      var label:String = ready.toString()                  // 'true'
      trace(label, label.length, (1 > 2).toString(), false.valueOf())

      // Boolean(x) is the conversion, not a constructor call
      trace(Boolean(0), Boolean('x'), Boolean(null))

      // methods used as values stay bound to their primitive
      var show:() -> String = ready.toString
      var parts:Array<() -> String> = [show, true.toString]
      for (var f:() -> String of parts) trace(f())

      // `Bool` is the prelude alias of `Boolean`: same members
      var flag:Bool = !ready
      trace(flag.toString(), Bool(1))                        // `Bool(x)` is the `Boolean(x)` conversion
    }

    private function objects():void {
      // Object.keys/values/entries read the own enumerable properties
      var config:Object = { host: 'localhost', port: 8080 }
      trace(Object.keys(config).join(','), Object.values(config).join(','), Object.entries(config)[1].join('='))
      trace(Object.hasOwn(config, 'port'), Object.hasOwn([7], 0), Object.is(Float.NaN, Float.NaN))

      // assign/freeze return their argument with its own type; the expected type names `T`
      var origin:Point = Object.assign({ x: 0, y: 0 } as Point, { y: 5 })
      var fixed:Point = Object.freeze({ x: 1, y: 2 })
      trace(origin.y, Object.isFrozen(fixed), Object.isFrozen(origin))

      // fromEntries builds an object from pairs or a map; groupBy sorts items into lists
      var ages:Map<String, int> = new Map([['ann', 31], ['bob', 27]])
      trace(JSON.stringify(Object.fromEntries(ages)), JSON.stringify(Object.fromEntries([['a', 1], ['b', 2]])))
      var parity:Object = Object.groupBy([1, 2, 3, 4, 5], (n:int, _:int):String => n % 2 == 0 ? 'even' : 'odd')
      trace(JSON.stringify(parity), Object.getPrototypeOf(parity) == null)
    }

    private function json():void {
      // parse gives `*`: an unchecked `as` gives it a shape
      var p:Point = JSON.parse('{"x": 1, "y": 2.5}') as Point
      trace(p.x + p.y)

      var data:* = { name: 'Rex', tags: ['dog', 'good'], age: 3 }
      trace(JSON.stringify(data))
      trace(JSON.stringify(data, ['name', 'age']))             // only these keys
      trace(JSON.stringify(data, null, 1))                     // indent by 1 space
      trace(JSON.stringify([1, [2]], null, '..'))              // indent string

      // replacer and reviver are typed functions
      trace(JSON.stringify(data, (key:String, value:*):* => key == 'age' ? value * 7 : value))
      var doubled:Array<int> = JSON.parse('[1, 2, 3]', (key:String, value:*):* => value is int ? value * 2 : value)   // `*` assigns to any type
      trace(doubled.length, doubled[2])

      // invalid input throws a JS SyntaxError, caught as an Exception
      try {
        JSON.parse('{oops}')
      } catch (e:Exception) {
        trace('parse failed:', e.name)
      }
    }

    private function numbers():void {
      // `Float`, `int` and `uint` share the members of JavaScript's Number
      var price:Float = 1234.5678
      var mask:int = 255
      trace(price.toFixed(2), price.toPrecision(3), price.toExponential(1), mask.toString(16), mask.toString(2))
      trace((0.1 + 0.2).toFixed(2), 3.75.toFixed(1), (255).toString(16))
      trace(price.toLocaleString('en-US'), price.toLocaleString(['de-DE'], { maximumFractionDigits: 1 }))

      // statics compile to `Number.…`
      trace(Float.MAX_SAFE_INTEGER, Float.EPSILON < 1e-15, Float.MIN_VALUE > 0, Float.NEGATIVE_INFINITY)
      trace(Float.parseInt('ff', 16), Float.parseFloat('3.5kg'), Float.isNaN(Float.parseInt('x')))

      // `is…` tests take any value, e.g. parsed JSON
      var raw:* = JSON.parse('[2, 2.5, "3", 9007199254740993]')
      for (var v:* of raw) trace(v, Float.isInteger(v), Float.isFinite(v), Float.isSafeInteger(v))

      // parseInt can be NaN or beyond the int range: it's a Float, convert explicitly
      var count:int = int(Float.parseInt('42'))
      trace(count + 1)
    }

    private static inline final HALF:int = (int.MAX_VALUE >> 1) + 1   // range constants fold at compile time

    private function integers():void {
      // AS3-style range constants (inline: they compile to literals)
      trace(int.MIN_VALUE, int.MAX_VALUE, uint.MIN_VALUE, uint.MAX_VALUE, HALF)
      trace(Int.MAX_VALUE, UInt.MAX_VALUE)                         // the prelude aliases work too

      // int and uint keep the number members, with whole-number results where guaranteed
      var flags:uint = 0xF0
      var same:uint = flags.valueOf()
      trace(flags.toString(2), same, (-42).toString(16), Int(7.9), UInt(-1) == uint.MAX_VALUE)

      // clamping with the constants
      var big:Float = 1e12
      var clamped:int = big > int.MAX_VALUE ? int.MAX_VALUE : int(big)
      trace(clamped)
    }

    private function logging():void {
      // `console` is a namespace of typed static methods; `trace(…)` is the short form of `console.log(…)`
      console.log('values:', 1, true, [1, 2])
      console.info('%s has %d items', 'cart', 3)           // printf-style formatting
      console.count('visits')
      console.count('visits')
      console.group('group')
      console.log('indented')
      console.groupEnd()
      console.assert(1 + 1 == 2, 'not printed')               // warn/error go to stderr
      var write:Function = console.log
      write('as a value')
    }

    private function maths():void {
      // rounding gives a Float (it can be NaN or exceed the int range): convert when it fits
      var cell:int = int(Math.floor(7.9))
      trace(cell, Math.round(-1.5), Math.ceil(2.1), Math.trunc(-2.9), Math.abs(-4), Math.sign(-8))

      // max/min/hypot take any number of values; an array is spread
      var scores:Array<Float> = [3, 9.5, 1]
      trace(Math.max(1, cell, 2.5), Math.min(...scores), Math.hypot(3, 4), Math.max())

      trace(Math.pow(2, 10), Math.sqrt(144), Math.PI > 3.14, Math.atan2(1, 1) * 4 == Math.PI)
      var roll:int = 1 + int(Math.random() * 6)
      trace(roll >= 1 && roll <= 6, Math.imul(65536, 65536), Math.clz32(1))
    }

    private function dates():void {
      // constructors: parts (local time), text, milliseconds, copy. Months count from 0.
      var leap:Date = new Date('2024-02-29T12:00:00Z')
      var epoch:Date = new Date(0)
      var copy:Date = new Date(leap)
      trace(leap.toISOString(), epoch.toISOString(), copy.getTime() == leap.getTime())
      trace(leap.getUTCFullYear(), leap.getUTCMonth() + 1, leap.getUTCDate(), leap.getUTCDay(), leap.getUTCHours())

      // setters return the new time value; a day past the end of the month rolls over
      var d:Date = new Date(Date.UTC(2020, 0, 31))
      d.setUTCMonth(1)
      trace(d.toISOString(), d.setUTCHours(5, 30), d.toISOString())

      // times are Floats (milliseconds): compare with getTime(), dates don't compare directly
      trace(Date.parse('2024-01-01T00:00:00Z'), Date.now() > 1.7e12, epoch.getTime() < leap.getTime())
      trace(JSON.stringify({ at: epoch }), leap.toUTCString(), leap.toLocaleDateString('en-US', { timeZone: 'UTC' }))

      // an invalid date isn't an error until it's formatted; check getTime() when input is untrusted
      var bad:Date = new Date('not a date')
      trace(Float.isNaN(bad.getTime()), bad.toJSON())
      try {
        bad.toISOString()
      } catch (e:RangeException) {
        trace('invalid date:', e.name)
      }
    }

    private function sets():void {
      // T is inferred from the array; duplicates collapse; add() returns the set, so calls chain
      var ids:Set<int> = new Set([3, 1, 3, 2])
      var tags:Set<String> = new Set<String>()
      tags.add('red').add('green').add('red')
      trace(ids.size, tags.size, ids.has(2), tags.delete('green'), tags.delete('blue'), tags.size)

      // for…of is typed: n is an int
      var total:int = 0
      for (var n:int of ids) total += n
      trace(total)
      ids.forEach((value:int, key:int, owner:Set<int>):Void => trace('each', value))

      // set algebra returns new sets; spread them into arrays to print
      var other:Set<int> = new Set([2, 3, 4])
      trace([...ids.union(other)].join(','), [...ids.intersection(other)].join(','), [...ids.difference(other)].join(','))
      trace(new Set([1]).isSubsetOf(ids), ids.isSupersetOf(other), ids.isDisjointFrom(new Set([9])))

      // a Xenon class can extend Set: the loop variable follows the type argument
      var seen:Seen = new Seen()
      seen.add('x')
      for (var s:String of seen) trace(s.toUpperCase())
      trace(new Set([Float.NaN, Float.NaN]).size)      // NaN is equal to NaN inside a Set
    }

    private function iterators():void {
      // values()/keys()/entries() return an Iterator<T>: single-use, consumed by for…of, toArray() or next()
      var ids:Set<int> = new Set([3, 1, 2, 5, 4])
      var it:Iterator<int> = ids.values()
      var first:IteratorResult<int> = it.next()
      trace(first.done, first.value)
      for (var n:int of it) trace('rest', n)
      trace(it.next().done)                       // used up

      // lazy helpers: nothing runs until the end of the chain is consumed; U is inferred from the callback
      var big:Array<int> = ids.values().map((n:int, i:int):int => n * 2).filter((n:int, i:int):Boolean => n > 4).toArray()
      trace(big.join(','), ids.values().take(2).toArray().join(','), ids.values().drop(3).toArray().join(','))
      for (var w:String of Iterator.from(['a', 'b']).map((s:String, i:int):String => s + i)) trace(w)
      trace(ids.values().some((n:int, i:int):Boolean => n > 4), ids.values().every((n:int, i:int):Boolean => n > 4))
      trace(ids.values().find((n:int, i:int):Boolean => n > 3), ids.values().reduce((sum:int, n:int, i:int):int => sum + n))
      for (var pair:Array<int> of ids.entries()) trace(pair.join('/'))
    }

    private function regexps():void {
      // `~/…/flags` literals and `new RegExp(text, flags)` are both a RegExp
      var date:RegExp = ~/(\d{4})-(\d{2})/
      var m:Array<String> = date.exec('on 2024-02-29')
      trace(m[0], m[1], m[2], (m as *).index)             // index, input and groups are untyped extras
      trace(date.exec('nothing') == null, date.test('1999-12'), date.source, date.flags.length)

      // a global regex remembers where it stopped: lastIndex
      var word:RegExp = new RegExp('\\w+', 'g')
      var count:int = 0
      while (word.exec('a bb ccc') != null) count++
      trace(count, word.global, word.ignoreCase, word.lastIndex, word.toString())
      word.lastIndex = 2
      trace(word.exec('a bb ccc')[0], word.lastIndex)

      // copies, optionally with other flags; named groups come through (m as *).groups
      var copy:RegExp = new RegExp(word, 'i')
      var named:Array<String> = ~/(?<year>\d{4})/.exec('in 1999')
      trace(copy.flags, (named as *).groups.year, 'a-b-c'.split(~/-/).length)
    }

    private function maps():void {
      // set() returns the map, so calls chain; get() is typed V (use has() first when V is a primitive)
      var ages:Map<String, int> = new Map<String, int>()
      ages.set('ann', 31).set('bob', 27).set('cid', 40)
      trace(ages.size, ages.get('ann') + 1, ages.has('zed'), ages.delete('bob'), ages.delete('bob'), ages.size)

      // destructuring a map loop types the pair: name is a String, age an int
      var total:int = 0
      for (var [name, age]:* of ages) {
        total += age
        trace(name.toUpperCase(), age)
      }
      trace(total)

      // constructors: from [key, value] pairs (declare the types) and as a copy
      var pairs:Map<String, int> = new Map([['x', 1], ['y', 2]])
      var copy:Map<String, int> = new Map(pairs)
      copy.set('z', 3)
      trace(pairs.size, copy.size)

      // keys(), values() and entries() are iterators
      trace(ages.keys().toArray().join(','), ages.values().toArray().join(','), ages.entries().toArray().length)
      ages.forEach((value:int, key:String, owner:Map<String, int>):Void => trace(key, value))

      // Map.groupBy builds a Map<K, Array<T>> from a function of each item
      var byLength:Map<int, Array<String>> = Map.groupBy(['a', 'bb', 'cc', 'd'], (w:String, i:int):int => w.length)
      trace(byLength.get(1).join(''), byLength.get(2).join(''), byLength.size)
    }

    private function strings():void {
      var t:String = '  Hello, World  '.trim()
      trace(t.length, t.charAt(1), t.at(-1), t.charCodeAt(0), t[4], String.fromCharCode(72, 105), '😀'.length)

      // searching (positions are ints, -1 when absent) and extracting
      trace(t.indexOf('o'), t.indexOf('o', 5), t.lastIndexOf('o'), t.includes('World'), t.startsWith('Hello'), t.endsWith('World'))
      trace(t.slice(7), t.slice(-5), t.substring(7, 5), t.split(', ').join('|'), 'a-b-c'.split('-', 2).length)

      // replace: text, regex (g = all), or a function of the match
      trace(t.replace('o', '0'), t.replaceAll('o', '0'), t.replace(~/[aeiou]/g, '*'), 'x1y2'.replace(~/(\d)/g, '<$1>'))
      trace(t.replaceAll(~/o/g, (m:String):String => m.toUpperCase()))

      // regular expressions: match gives the match array or null; matchAll an iterator of matches
      var m:Array<String> = 'id=42'.match(~/(\w+)=(\d+)/)
      trace(m[1], m[2], 'no'.match(~/\d/) == null, 'a1b2'.match(~/\d/g).join(','), 'a1b2'.search(~/\d/))
      for (var hit:Array<String> of 'a1b22'.matchAll(~/\d+/g)) trace(hit[0])

      trace('ab'.repeat(3), '7'.padStart(3, '0'), '7'.padEnd(3, '.'), 'Hi'.toUpperCase(), 'b'.localeCompare('a'), 'é'.normalize('NFD').length)

      // a method used as a value stays bound to its string
      var has:(String) -> Boolean = t.includes
      trace(has('World'), has('xyz'))
    }

    private function arrays():void {
      // mutating methods: push/pop/shift/unshift/splice/reverse/sort/fill change the array
      var nums:Array<int> = [3, 1, 2, 10]
      trace(nums.push(5, 6), nums.pop(), nums.shift(), nums.unshift(0), nums.join('-'), nums.at(-1))
      nums.sort()                                                   // by text: 0,1,10,2,3,5
      trace(nums.join(','))
      nums.sort((a:int, b:int):int => a - b)                        // numbers need a comparator
      trace(nums.join(','), nums.toSorted((a:int, b:int):int => b - a).join(','), nums.join(','))

      // callbacks are typed; map<U> infers U from what the callback returns
      var labels:Array<String> = nums.map((x:int, i:int):String => 'n' + x)
      trace(labels.join(','), nums.filter((x:int, i:int):Boolean => x > 2).length)
      trace(nums.reduce((acc:int, x:int, i:int, all:Array<int>):int => acc + x), nums.reduce((acc:String, x:int, i:int, all:Array<int>):String => acc + x, ''))
      trace(nums.some((x:int):Boolean => x > 9), nums.every((x:int):Boolean => x > 9), nums.find((x:int):Boolean => x > 2), nums.findIndex((x:int):Boolean => x > 2))

      // copies leave the array alone; splice removes and inserts
      var removed:Array<int> = nums.splice(1, 2, 7, 8, 9)
      trace(removed.join(','), nums.join(','), nums.slice(-2).join(','), nums.concat([1], [2]).join(','), nums.toReversed().join(','), nums.with(0, 99)[0])

      // statics: Array.isArray, Array.of, Array.from (array, set, iterator, string, or length + mapper)
      trace(Array.isArray(nums), Array.of(1, 2).length, Array.from('abc').join('+'), Array.from(new Set([5, 6])).join(','))
      trace(Array.from({ length: 3 }, (_:*, i:int):int => i * i).join(','), [[1], [2]].flat().length)

      // iterators, and length is assignable (it cuts the array)
      trace(nums.keys().toArray().join(','), nums.entries().toArray()[0].join(':'))
      nums.length = 2
      trace(nums.length, nums.includes(0), nums.indexOf(99))
    }
  }
}

typedef Point = { x:Float, y:Float }

class Seen extends Set<String> {}
