package {
  public class Main {
    private static var calls:int = 0
    private var pos:Vec2 = new Vec2(0, 0)

    public function Main() {
      var a:Vec2 = new Vec2(1, 2)
      var b:Vec2 = a + new Vec2(3, 4)
      b += a
      trace('pos: ' + b, String(a + b + b))

      pos += new Vec2(10, 10)
      pos += pos
      trace('field', String(pos))

      // object and index are evaluated once
      var path:Array<Vec2> = [new Vec2(0, 0), new Vec2(1, 1)]
      next(path)[index()] += new Vec2(5, 5)
      trace('path', String(path[1]), 'calls', Main.calls)

      // the result type can differ from the class
      var total:Money = new Coins(3) + new Coins(4)
      trace(String(total))

      // inherited and overridden operators, and operators through an interface
      var s:Scaled = new Scaled(1, 1)
      trace(String(s + new Vec2(1, 1)))
      var adder:IAddable = new Vec2(2, 2)
      trace(String(adder + new Vec2(1, 1)))

      // `-`, `*` and `/` (the right operand's type is the method's parameter: here a `Float`)
      var d:Vec2 = new Vec2(8, 6)
      trace(String(d - a), String(d * 2), String(d / 2), String((d - a) * 3 + a))
      d -= a
      d *= 10
      d /= 4
      trace(String(d))

      // `==` compares by value with `operator==`, `!=` is its negation; null never reaches it
      var same:Vec2 = new Vec2(1, 2)
      var none:Vec2? = null
      trace(a == same, a != same, a == d, none == a, none == null, Object.is(a, same))
    }

    private function next(v:Array<Vec2>):Array<Vec2> {
      Main.calls++
      return v
    }

    private function index():int {
      Main.calls++
      return 1
    }
  }
}

interface IAddable {
  function operator+(other:Vec2):Vec2 const
}

class Vec2 implements IAddable {
  public final x:Float
  public final y:Float
  public function Vec2(x:Float, y:Float) { this.x = x; this.y = y }

  public function operator+(other:Vec2):Vec2 const { return new Vec2(x + other.x, y + other.y) }
  public function operator-(other:Vec2):Vec2 const => new Vec2(x - other.x, y - other.y)
  public function operator*(factor:Float):Vec2 const => new Vec2(x * factor, y * factor)
  public function operator/(divisor:Float):Vec2 const => new Vec2(x / divisor, y / divisor)
  public function operator==(other:Vec2):Boolean const => x == other.x && y == other.y

  override public function toString():String { return $'({x}, {y})' }
}

class Scaled extends Vec2 {
  override public function operator+(other:Vec2):Vec2 const { return new Vec2(x + other.x * 10, y + other.y * 10) }
}

class Coins {
  private final n:int
  public function Coins(n:int) { this.n = n }
  public function operator+(other:Coins):Money const { return new Money((n + other.n) * 25) }
}

class Money {
  private final cents:int
  public function Money(cents:int) { this.cents = cents }
  override public function toString():String { return '$' + int(cents / 100) + '.' + cents % 100 }
}
