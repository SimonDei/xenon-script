package com.zoo {
  import com.zoo.food.Food

  public class Animal {
    private static var count:Int = 0
    public final name:String
    private var eaten:Array<Food> = []

    public function Animal(name:String) {
      this.name = name
      count++
    }

    public function feed(food:Food):Void {
      eaten.push(food)
      food.eatenBy = this
    }

    public function get calories():Int {
      var total:Int = 0
      for (var f:Food of eaten) total += f.calories
      return total
    }

    public static function get population():Int { return count }
  }
}
