package {
  public class Main {
    public static const LIMIT:UInt = 4000000000
    private static var created:Int = 0
    private var _name:String = 'anon'
    private final id:Int

    public function Main() {
      id = ++created
      trace(id, LIMIT, Main.LIMIT > 0)

      var half:Int = Int(7 / 2)
      var exact:Float = 7 / 2
      var mixed:Float = half + exact
      trace(half, exact, mixed, 2 ** 10, 17 % 5, 1 << 4, -8 >> 1, -8 >>> 28)

      name = 'Xenon'
      trace(name, name.length, describe(3), describe(1, '!'))

      var maybe:String? = null
      trace(maybe ?? 'default', maybe == null, maybe != null)
      var picked:String = half > 2 ? 'big' : 'small'
      trace(picked, !(half > 2), typeof half)

      var dyn:* = { a: 1 }
      trace(dyn.a + 1, dyn.missing == null)

      var total:Float = Main.sum(1, 2, 3.5)
      var none:Float = Main.sum()
      trace(total, none)

      // `(expr : Type)`: a compile-time type check, gone at runtime. The value is typed against
      // `Type` (a literal takes it from there) and is a `Type` from then on.
      var pairs:Array<*> = [(['x', 1] : Tuple<String, Int>), (['y', 2] : Tuple<String, Int>)]
      trace((pairs[0] : Tuple<String, Int>)[0].toUpperCase(), ([] : Array<Int>).length, ((total : Float) / 2 : Float))

      // Unions and literal types: a value of one of several types, or one of a few values.
      // `is`, `==` and null checks narrow them.
      var id:Int | String = 'a7'
      if (id is String) trace(id.toUpperCase())
      id = 7
      trace(Main.size('s'), Main.size('l'), Main.kind(id), Main.kind('x'))
    }

    private static function size(s:'s' | 'm' | 'l'):Int => s == 's' ? 1 : s == 'm' ? 2 : 3

    private static function kind(v:Int | String):String {
      if (v is Int) return 'number ' + (v + 1)
      return 'text ' + v.length
    }

    public function get name():String { return _name }
    public function set name(value:String):Void { _name = value.toUpperCase() }

    private function describe(n:Int, suffix:String = '.'):String {
      return 'n=' + n + suffix
    }

    public static function sum(...values:Array<Float>):Float {
      var total:Float = 0
      var i:Int = 0
      while (i < values.length) {
        total += values[i]
        i++
      }
      return total
    }
  }
}
