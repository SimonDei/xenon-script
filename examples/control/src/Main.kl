package {
  public class Main {
    public function Main() {
      // C-style for, including an empty header part
      var squares:String = ''
      for (var i:int = 1; i <= 4; i++) squares += i * i + ' '
      trace(squares)
      var countdown:String = ''
      for (var j:int = 3; j > 0; j -= 1) countdown += j
      trace(countdown)

      // ranges
      var r:Array = []
      for (var n:int of 0..5) r.push(n)
      for (var n:int of 0..=10 step 5) r.push(n)
      for (var n:int of 5..0) r.push(-1)
      var limit:int = 3
      for (var n:int of 0..limit) r.push(n * 10)
      trace(r.join(','))

      // open range with break: the counter has nothing to do with the stop condition
      var names:Array = []
      for (var k:int of 2..) {
        names.push($'value_{k}')
        if (names.length == 3) break
      }
      trace(names.join(' '))

      // for-of / for-in
      var letters:Vector<String> = ['a', 'b', 'c']
      var joined:String = ''
      for (var ch:String of letters) {
        if (ch == 'b') continue
        joined += ch
      }
      for (var c:String of 'xyz') joined += c.toUpperCase()
      trace(joined)
      var keys:Array = []
      for (var key:String in { one: 1, two: 2 }) keys.push(key)
      trace(keys.join('+'))

      // switch with fall-through and per-case scopes
      for (var v:int of 0..4) trace(v, kind(v))

      // if / while with bindings
      if (var found:String = find('b'), found.length == 1) trace('found', found)
      else trace('not found')
      if (var missing:String = find('zz')) trace('unexpected', missing)
      else trace('no zz')

      var queue:Array = ['x', 'y']
      while (var item:String = queue.shift()) trace('item', item)

      // do-while
      var tries:int = 0
      do tries++ while (tries < 3)
      trace('tries', tries)
      trace(sign(-4), sign(0), sign(9))
    }

    private function kind(v:int):String {
      switch (v) {
        case 0:
          return 'zero'
        case 1:
        case 2:
          var label:String = 'small'
          return label + v
        default:
          var label:String = 'big'
          return label
      }
    }

    private function find(s:String):String {
      return s.length == 1 ? s : null
    }

    private function sign(n:int):int {
      if (n < 0) return -1
      else if (n == 0) return 0
      else return 1
    }
  }
}
