// JavaScript iteration: `Iterable<T>` hands out an `Iterator<T>` through `[Symbol.iterator]()`.
// Arrays, strings, Set, Map and Iterator are iterable.
public class Main {
  public function Main() {
    // a class of our own works with `for … of`, and wherever an Iterable<int> is wanted
    var countdown:Countdown = new Countdown(3)
    for (var n:Int of countdown) trace('countdown', n)
    trace(total(countdown), total([1, 2, 3]), total(new Set([4, 5])), total(new Map([['a', 6]]).values()))

    // generic code over any enumerable: T comes from the argument
    trace(firstOf(countdown) ?? -1, firstOf('xyz'), firstOf(new Set(['only'])), count('héllo'))

    // `is Iterable` asks the value itself (true for JavaScript iterables too)
    var values:Array<*> = [countdown, 'text', 42, [1], null]
    trace(values.map((v:*, i:Int):Bool => v is Iterable).join(' '))
  }

  private function total(numbers:Iterable<Int>):Int {
    var sum:Int = 0
    for (var x:Int of numbers) sum += x
    return sum
  }

  private function count(items:Iterable<*>):Int {
    var c:Int = 0
    for (var item:* of items) c++
    return c
  }

  private function firstOf<T>(items:Iterable<T>):T? {
    for (var item:T of items) return item
    return null
  }
}

/** Counts down from `from` to 1 with a generator-compatible iterator. */
class Countdown implements Iterable<Int> {
  private var from:Int

  public function Countdown(from:Int) {
    this.from = from
  }

  public function [Symbol.iterator]():Iterator<Int> {
    var values:Array<Int> = []
    for (var n:Int of 1..=from) values.unshift(n)
    return values.values()
  }
}

/** Enumerates the songs of an array it holds. */
class Playlist implements Iterable<String> {
  private var songs:Array<String>

  public function Playlist(songs:Array<String>) {
    this.songs = songs
  }

  public function [Symbol.iterator]():Iterator<String> {
    return songs.values()
  }
}
