// Enumerables, C#-style: `IEnumerable<T>` hands out an `IEnumerator<T>` (`moveNext()` + `current`).
// Arrays, strings, Set, Map and Iterator are enumerable; a class becomes one by implementing
// `getEnumerator()`, and then works with `for … of` (in the JavaScript output too).
public class Main {
  public function Main() {
    // a class of our own works with `for … of`, and wherever an IEnumerable<int> is wanted
    var countdown:Countdown = new Countdown(3)
    for (var n:int of countdown) trace('countdown', n)
    trace(total(countdown), total([1, 2, 3]), total(new Set([4, 5])), total(new Map([['a', 6]]).values()))

    // stepping by hand, as C#'s foreach does
    var e:IEnumerator<String> = new Playlist(['intro', 'song', 'outro']).getEnumerator()
    while (e.moveNext()) trace('playing', e.current)
    var letters:IEnumerator<String> = 'abc'.getEnumerator()   // built-ins have enumerators too
    while (letters.moveNext()) trace('letter', letters.current)

    // generic code over any enumerable: T comes from the argument
    trace(firstOf(countdown) ?? -1, firstOf('xyz'), firstOf(new Set(['only'])), count('héllo'))

    // `is IEnumerable` asks the value itself (true for JavaScript iterables too)
    var values:Array<*> = [countdown, 'text', 42, [1], null]
    trace(values.map((v:*, i:int):Boolean => v is IEnumerable).join(' '))
  }

  private function total(numbers:IEnumerable<int>):int {
    var sum:int = 0
    for (var x:int of numbers) sum += x
    return sum
  }

  private function count(items:IEnumerable<*>):int {
    var c:int = 0
    var e:IEnumerator<*> = items.getEnumerator()
    while (e.moveNext()) c++
    return c
  }

  private function firstOf<T>(items:IEnumerable<T>):T? {
    for (var item:T of items) return item
    return null
  }
}

/** Counts down from `from` to 1 with an enumerator class of its own. */
class Countdown implements IEnumerable<int> {
  private var from:int

  public function Countdown(from:int) {
    this.from = from
  }

  public function getEnumerator():IEnumerator<int> {
    return new CountdownEnumerator(from)
  }
}

class CountdownEnumerator implements IEnumerator<int> {
  private var next:int

  public function CountdownEnumerator(from:int) {
    next = from + 1
  }

  public function moveNext():Boolean {
    next--
    return next > 0
  }

  public function get current():int {
    return next
  }
}

/** Enumerates the songs of an array it holds: hands out the array's enumerator. */
class Playlist implements IEnumerable<String> {
  private var songs:Array<String>

  public function Playlist(songs:Array<String>) {
    this.songs = songs
  }

  public function getEnumerator():IEnumerator<String> {
    return songs.getEnumerator()
  }
}
