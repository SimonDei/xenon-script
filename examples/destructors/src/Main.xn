package {
  public class Main {
    public static var log:Array<String> = []

    public function Main() {
      scoped()
      flush()

      try {
        var f:FileHandle = new FileHandle('data.txt')
        throw new StateException('disk on fire')
      } catch (e:StateException) {
        log.push('caught ' + e.message)
      }
      flush()

      var opened:FileHandle = open('made.txt')   // `open` hands its value on: destroyed at the end of Main()
      log.push('got ' + opened.name)
      new FileHandle('temp.txt').touch()         // a temporary: destroyed when the statement ends
      for (var i:int of 0..2) {
        var part:FileHandle = new FileHandle('part' + i)
        part.touch()
      }                                          // one destruction per iteration
      flush()

      // Manual disposal: classes implementing `IDisposable` (no destructor) can be kept anywhere.
      var early:Socket = new Socket('early')
      early.dispose()
      early.dispose()                            // second call: no-op
      using (a:Socket = new Socket('a'), b:Socket = new Socket('b')) {
        log.push('in block')
      }
      using (early) log.push('expression form')
      flush()
      var thing:* = early
      var other:* = log
      trace(thing is IDisposable, other is IDisposable)

      void run()                             // starts the async part; nothing waits for it
    }

    private static function flush():void {
      trace(log.join(' | '))
      log = []
    }

    private function scoped():void {
      var first:FileHandle = new FileHandle('first')
      var second:Lock = new Lock('second')
      log.push('working')
    }                                           // second (unlock, then close), then first

    private function open(name:String):FileHandle {
      var handle:FileHandle = new FileHandle(name)
      handle.touch()
      return handle                             // the caller owns it now: not destroyed here
    }

    private async function run():Promise<void> {
      var conn:Connection = new Connection()     // async destructor: awaited when run() ends
      log.push('connected')
    }
  }
}

/** Scoped: destroyed when the scope owning it ends. */
class FileHandle {
  public final name:String
  public function FileHandle(name:String) { this.name = name }
  public function touch():void { Main.log.push('touch ' + name) }
  public function ~FileHandle() { Main.log.push('close ' + name) }
}

class Lock extends FileHandle {
  public function Lock(name:String) { super(name + '.lock') }
  public function ~Lock() {
    Main.log.push('unlock')
    if (Main.log.length > 0) return         // the parent destructor still runs
    Main.log.push('not reached')
  }
}

class Connection {
  public async function ~Connection() {
    await Promise.resolve()
    Main.log.push('disconnected')
    trace(Main.log.join(' | '))
  }
}

/** Manual: no destructor; `using` (or a call) runs its `dispose()`. */
class Socket implements IDisposable {
  private final name:String
  private var closed:Boolean = false
  public function Socket(name:String) { this.name = name }
  public function dispose():void {
    if (closed) return
    closed = true
    Main.log.push('close socket ' + name)
  }
}
