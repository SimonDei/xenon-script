package {
  import store.SaveException

  public class Main {
    private var log:Array = []

    public function Main() {
      // typed catches, most specific first
      for (var i:int of 0..4) trace(i, attempt(i))

      // JavaScript errors arrive as Klass exceptions, the original is kept in `cause`
      try {
        JSON.parse('{oops')
      } catch (e) {
        trace(e.name, e.cause != null, e.stack != null)
      }
      try {
        var nothing:* = null
        trace(nothing.field)
      } catch (e:TypeException) {
        trace('type:', e.name == 'TypeException', e.message.length > 0)
      }
      try {
        new Array(-1)
      } catch (e:RangeException) {
        trace('range:', e.name)
      }

      // unmatched exceptions pass through unchanged to an outer handler
      try {
        try {
          throw new StateException('busy')
        } catch (e:ArgumentException) {
          trace('not reached')
        } finally {
          log.push('inner finally')
        }
      } catch (e:StateException) {
        log.push('outer caught ' + e.message)
      }
      trace(log.join(', '))

      var save:SaveException = new SaveException('/tmp/x', 'disk full')
      trace(String(save), save.path, save.name)
    }

    private function attempt(i:int):String {
      try {
        risky(i)
        return 'ok'
      } catch (e:SaveException) {
        return 'save failed at ' + e.path
      } catch (e:ArgumentException) {
        return 'bad argument: ' + e.message
      } catch (e:Exception) {
        return 'other: ' + e.name
      } finally {
        log.push(i)
      }
    }

    private function risky(i:int):void {
      switch (i) {
        case 1: throw new SaveException('/data/db', 'disk full')
        case 2: throw new ArgumentException('i must not be 2')
        case 3: throw new NotImplementedException()
      }
    }
  }
}
