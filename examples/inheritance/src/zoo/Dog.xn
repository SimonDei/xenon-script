package zoo {
  public class Dog extends Animal {
    private var _tricks:Int

    public function Dog(name:String, tricks:Int = 0) {
      super(name)
      _tricks = tricks
    }

    override public function speak():String { return 'woof' }

    // Only the getter is overridden; the inherited setter keeps working.
    override public function get name():String { return 'Dog ' + super.name }

    public function get tricks():Int { return _tricks }
  }
}
