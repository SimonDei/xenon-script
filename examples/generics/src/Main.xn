package {
  import util.*

  public class Main {
    public function Main() {
      // explicit and inferred type arguments
      var a:Box<Int> = new Box<Int>(5)
      var b:Box<String> = a.map((n) => 'n=' + n)          // U inferred as String
      var c:Box<Float> = new Box(2.5)                      // T inferred from the argument
      var d:Box<Array<Int>> = Box.of([1, 2, 3])            // V inferred from the array
      trace(a.get() + 1, b.get().toUpperCase(), c.get() * 2, d.get().length)

      var lengths:Box<Int> = b.map((s) => s.length).map((n) => n * 10)
      trace(lengths.get())

      // generic interface with concrete arguments
      var words:Array<Word> = [new Word('pear'), new Word('fig'), new Word('banana')]
      trace(best(words).text, best([new Word('x'), new Word('yy')]).text)

      // generic and non-generic subclasses of a generic class
      var counter:Counter = new Counter()
      counter.set(41)
      counter.bump()
      trace(counter.get())
      var tagged:Tagged<String> = new Tagged('v', 'tag')
      trace(tagged.get(), tagged.tag)

      // `*` as a type argument is a wildcard: any `Box<T>` fits a `Box<*>`, any array fits `Array`
      var boxes:Array<Box<*>> = [a, b, c]
      var ints:Array<Int> = [4, 5, 6]
      trace(boxes.length, total(ints), total([1.5, 2.5]))

      // generic typedefs, including a recursive one
      var p:Pair<String, Int> = { first: 'age', second: 31 }
      var list:Chain<String> = { value: 'a', next: { value: 'b' } }
      trace(p.first, p.second + 1, list.value + list.next?.value)

      // local generic function and swap
      function swap<A, B>(x:Pair<A, B>):Pair<B, A> { return { first: x.second, second: x.first } }
      var q:Pair<Int, String> = swap(p)
      trace(q.first, q.second)

      // the expected type fills in what the arguments can't
      var empty:Array<String> = makeList()
      empty.push('only')
      trace(empty.length)
    }

    private function best(items:Array<Word>):Word {
      var top:Word = items[0]
      for (var w:Word of items) if (w.compareTo(top) > 0) top = w
      return top
    }

    private function makeList<T>():Array<T> { return [] }

    /** Takes any array (`Array` = `Array<*>`): elements are `*`. */
    private function total(values:Array):Float {
      var sum:Float = 0
      for (var v:* of values) sum += v
      return sum
    }
  }
}

typedef Pair<A, B> = { first:A, second:B }
typedef Chain<T> = { value:T, ?next:Chain<T> }

class Word implements IComparable<Word> {
  public final text:String
  public function Word(text:String) { this.text = text }
  public function compareTo(other:Word):Int { return text.length - other.text.length }
}

class Counter extends Box<Int> {
  public function Counter() { super(0) }
  public function bump():Void { set(get() + 1) }
}

class Tagged<T> extends Box<T> {
  public final tag:String
  public function Tagged(value:T, tag:String) {
    super(value)
    this.tag = tag
  }
}
