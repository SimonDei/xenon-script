package {
  import shapes.*

  public class Main {
    public function Main() {
      var all:Array<IShape> = [new Circle(1), new Square(2), new Cube(1)]
      for (var s:IShape of all) {
        trace(s.name, s.draw(), Int(s.area() * 100) / 100, s is IScalable, s is Cube)
      }

      for (var s:IShape of all) {
        if (var sc:IScalable = s as IScalable) sc.scale(2)
      }
      trace(all.map((s:IShape):String => s.name + '=' + Int(s.area())).join(' '))

      var d:IDrawable = all[1]
      var text:* = 'text'
      var nothing:* = null
      trace(d.draw(), d is Square, d is Circle, text is IShape, nothing is IShape)
      var anything:* = { draw: () => 'fake' }
      trace(anything is IDrawable)
    }
  }
}
