// An immutable value with a `constexpr` constructor: objects can be built at compile time, and
// its `constexpr` methods evaluated on them. A `constexpr` method is always `const` (it never
// changes its object), so writing `const` is optional.
public class Size {
  public final width:int
  public final height:int

  public constexpr function Size(width:int, height:int) {
    this.width = width
    this.height = height
  }

  public constexpr function area():int const => width * height
  public constexpr function scaled(factor:int):Size => new Size(width * factor, height * factor)
  public constexpr function operator+(other:Size):Size => new Size(width + other.width, height + other.height)
  public constexpr function operator==(other:Size):Boolean const => width == other.width && height == other.height
}
