package {
  import game.Config

  public class Main {
    private static inline final HALF_HP:int = Config.MAX_HP / 2
    private static inline final RATIO:Float = HALF_HP / 3
    private static inline final DEBUG:Boolean = HALF_HP > 40 && !false
    private static inline const NEG:int = -HALF_HP

    public function Main() {
      inline const LOW:int = HALF_HP - Config.STEP
      trace(Config.TITLE, Config.MAX_HP, HALF_HP, LOW, NEG)
      trace(RATIO, DEBUG, int(RATIO * 10) / 10)
      for (var hp:int of 0..=Config.MAX_HP step Config.STEP) trace(hp, describe(hp))
      var big:uint = 2 ** 31
      trace(big, 5 - NEG)

      // `constexpr` functions: computed at compile time when the arguments are constants
      // (`kib(64)` becomes 65536 in the output), an ordinary call otherwise
      var n:int = 3
      trace(BUFFER, kib(2), fact(10), percent(Config.MAX_HP, HALF_HP), kib(n), fact(n))
      trace(fib(30), fib(n))
    }

    private static inline final BUFFER:int = kib(64)
    private static constexpr function kib(n:int):int => n * 1024
    private static constexpr function fact(n:int):int => n <= 1 ? 1 : n * fact(n - 1)
    private static constexpr function percent(total:int, part:int):String => $'{Math.round(part / total * 100)}%'

    // A block body: locals, loops and `if` run at compile time too.
    private static constexpr function fib(n:int):int {
      var a:int = 0
      var b:int = 1
      for (var i:int of 0..n) {
        var next:int = a + b
        a = b
        b = next
      }
      return a
    }

    private function describe(hp:int):String {
      switch (hp) {
        case Config.MAX_HP: return 'full'
        case HALF_HP: return 'half'
        case 0: return 'dead'
        default: return hp > HALF_HP ? 'ok' : 'low'
      }
    }
  }
}
