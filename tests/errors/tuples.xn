public class Main {
  public function Main() {
    var short:Tuple<String, int> = ['a']                  // X0323: one element missing
    var long:Tuple<String, int> = ['a', 1, true]          // X0323: one too many
    var wrong:Tuple<String, int> = [1, 'a']               // X0308 twice: positions swapped
    var spread:Tuple<int, int> = [...[1, 2]]              // X0323: a spread's length isn't known
    var pair:Tuple<String, int> = ['a', 1]
    trace(pair[2])                                        // X0324: positions 0 and 1
    pair[1] = 'two'                                       // X0308: position 1 is an `int`
    var [a, b, c] = pair                                  // X0773: two elements
    var list:Array<int> = [1, 2]
    var fromList:Tuple<int, int> = list                   // X0308: an array's length isn't known
    var other:Tuple<String, Float> = pair                 // X0308: positions are compared exactly
    var asArray:Array<*> = pair                           // fine: a tuple is an array
    var bare:Tuple = pair                                 // X0422: `Tuple` needs its element types
    var i:int = 1
    var either:String = pair[i]                           // X0308: any position: `String | int`
    trace(short, long, wrong, spread, a, b, c, fromList, other, asArray, bare, either)
  }
}
