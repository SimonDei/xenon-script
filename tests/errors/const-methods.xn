package {
  public class Main {
    private var total:Float = 0
    private var items:Array = []
    private var _v:int = 0

    public function Main() {}

    public function add(x:*):void { items.push(x) }
    public function get v():int { return _v }
    public function set v(x:int):void { _v = x }
    public function count():int const { return items.length }

    public function report():String const {
      total = 0
      this.total += 1
      _v++
      v = 3
      add(1)
      this.add(2)
      trace(v)
      var f:Function = add
      items.push(5)
      var g:Function = ():void => { total = 1 }
      var h:Function = function():void { this.total = 2 }
      return 'x' + count()
    }

    public static function make():Main const { return null }
    public function set w(x:int):void const {}
  }
}

interface IShape {
  function area():Float const
}

class Square implements IShape {
  public function area():Float { return 1 }
}

class Base {
  public function size():int const { return 0 }
}

class Child extends Base {
  override public function size():int { return 1 }
}
