package {
  public class Main {
    private var _v:int = 0
    private var other:Main? = null

    public function Main() {
      trace(writeOnly)
      writeOnly = 3
      writeOnly += 1
      var f:Function? = other?.helper
    }

    public function set writeOnly(v:int):int { _v = v; return v }

    public function get mixed():int { return _v }
    private function set mixed(v:int):void { _v = v }
    public function set aliased(v:int):Void { _v = v }        // fine: `Void` is `void`

    public function helper():void {}
  }
}
