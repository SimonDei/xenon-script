package {
  public class Main {
    public function Main() {
      using n:int = 5
      using p:Plain = new Plain()
      using s:Sock = new Sock()
      var leak:Res = new Res()
      leak.touch()
      var kept:Res = new Res()
      Main.keep(kept)
      await using r:Res = new Res()
    }

    public static function keep(r:Res):void {}
  }
}

class Plain {}

class Res implements IDisposable {
  public function touch():void {}
  public function dispose():void {}
}

class Sock implements IAsyncDisposable {
  public async function dispose():Promise<void> {}
}

class Bad {
  private function ~Bad(x:int):void {}
  public function ~Other() {}
}

class AsyncBase {
  public async function ~AsyncBase() {}
}

class SyncChild extends AsyncBase {
  public function ~SyncChild() {}
}

class Both implements IDisposable {
  public function ~Both() {}
  public function dispose():void {}
}

class ResChild extends Res {
  public function ~ResChild() {}
}

class Missing implements IDisposable {
}
