public class Main {
  public function Main() {
    setTimout(() => trace('x'), 10)                  // typo
    setTimeout(10, () => trace('x'))                 // arguments swapped (JS habit from other APIs)
    var n:int = 0
    setTimeout(() => n++, 10)                        // a callback may return a value; it's ignored
    var encoded:int = encodeURIComponent('a b')
    var text:String = btoa(42)
    void fetch('/api', 'POST')                          // options are an object: { method: 'POST' }
    void fetch('/api', { methd: 'POST', keepalive: 1 })   // RequestInit is checked like any shape
    var copy:Array<String> = structuredClone([1, 2])
    queueMicrotask(async () => { await fetch('/x') })  // fine: an async callback whose result is ignored
    var f:() -> int = async () => { return 1 }        // but an async arrow can't produce an `int`
    trace(encoded, text, copy, f, twice(2))
  }
}

function twice(x:int):int { return x * 2 }          // functions belong to classes
