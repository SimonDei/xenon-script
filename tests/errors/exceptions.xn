package {
  public class Main {
    public function Main() {
      throw 'failed'
    }

    private function f():void {
      throw 42
    }

    private function g():void {
      var e:Error = new Error('x')
      throw new TypeError('bad')
    }

    private function h():void {
      try {
        trace(1)
      } catch (e:Exception) {
        trace(2)
      } catch (e:StateException) {
        trace(3)
      }
      try {} catch (e:*) {}
      try {} catch (e:String) {}
      try {}
    }

    private function k():int {
      try {
        return 1
      } catch (e) {
        throw e
      }
    }

    private function m(x:*):void {
      throw x
    }

    private static async function failure():Promise<Exception> {
      return new Exception('failed')
    }

    // An async function's exception: `await` is suggested (inside `async`), noted (outside).
    private async function n():Promise<void> {
      throw failure()
    }

    private function o():void {
      throw failure()
    }
  }
}
