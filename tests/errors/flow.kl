package {
  public class Main {
    public function Main() {
      break
      while (true) {
        switch (1) {
          case 1:
            continue
        }
      }
      switch (2) { default: continue }
    }

    private function sign(n:int):int {
      if (n < 0) return -1
      else if (n > 0) return 1
    }

    private function first(xs:Array):String {
      for (var x:String of xs) return x
    }

    private function forever():int {
      while (true) {}
    }

    private function grade(n:int):String {
      switch (n) {
        case 1: return 'one'
        default: return 'many'
      }
    }

    private function early():void {
      return
      trace('never')
    }
  }
}
