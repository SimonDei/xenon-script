public class Main {
  public function Main() {
    for (var x:* of new Plain()) trace(x)            // not enumerable
    total(['a', 'b'])                                 // Iterable<int> needs int elements
    total(42)                                         // an int isn't enumerable
    for (var w:int of new Words()) trace(w)          // Words yields Strings
    var e:IEnumerator<int> = [1, 2].getEnumerator()
    trace(e.current + e.moveNext())                   // current is an int, moveNext() a Boolean
  }
  private function total(xs:Iterable<int>):int { return 0 }
}
class Plain {}
class Missing implements Iterable<int> {}         // getEnumerator() is missing
class Words implements Iterable<String> {
  public function getEnumerator():IEnumerator<String> { return ['a'].getEnumerator() }
}
class WrongReturn implements Iterable<int> {
  public function getEnumerator():Array<int> { return [] }
}
class HalfEnumerator implements IEnumerator<int> {
  public function moveNext():Boolean { return false }
}
