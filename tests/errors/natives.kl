package {
  public class Main {
    public function Main() {
      var d:Date = new Date(true)
      var t:String = 'abc'
      trace(t.toUppercase(), t.newApi(), d.getYear(), t.split(5))
      var ok:* = (t as *).newApi()
      trace(ok, new Widget())
    }
  }
}

// A native class describes JS: bodies, initializers and static blocks are errors.
native class Widget {
  function Widget()
  function size():int { return 0 }
  var offset:int = 5
  static { trace('x') }
}

native class String {
  function toUpperCase():String
  function split(separator:String):Array<String>
  function split(separator:RegExp):Array<String>
}
