{
  "name": "vscode-klass",
  "displayName": "Klass",
  "description": "Syntax highlighting for the Klass language (.kl)",
  "version": "0.1.0",
  "publisher": "klass",
  "license": "MIT",
  "private": true,
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "klass",
        "aliases": ["Klass", "klass"],
        "extensions": [".kl"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "klass",
        "scopeName": "source.klass",
        "path": "./syntaxes/klass.tmLanguage.json"
      }
    ]
  }
}
