{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Xenon",
  "scopeName": "source.xenon",
  "fileTypes": [
    "xn"
  ],
  "patterns": [
    {
      "include": "#code"
    }
  ],
  "repository": {
    "code": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#regex"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#package"
        },
        {
          "include": "#import"
        },
        {
          "include": "#native"
        },
        {
          "include": "#type-declaration"
        },
        {
          "include": "#typedef"
        },
        {
          "include": "#function-declaration"
        },
        {
          "include": "#destructor"
        },
        {
          "include": "#variable-declaration"
        },
        {
          "include": "#for-header"
        },
        {
          "include": "#dynamic-type"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#builtin-types"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#types"
        },
        {
          "include": "#function-call"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        },
        {
          "include": "#braces"
        },
        {
          "include": "#parens"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.xenon",
          "begin": "/\\*\\*(?!/)",
          "end": "\\*/",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.xenon"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.xenon"
            }
          },
          "patterns": [
            {
              "name": "storage.type.class.doc.xenon",
              "match": "(?<=\\s|\\*)@[A-Za-z]+\\b"
            },
            {
              "name": "markup.inline.raw.xenon",
              "match": "`[^`\\n]*`"
            }
          ]
        },
        {
          "name": "comment.block.xenon",
          "begin": "/\\*",
          "end": "\\*/",
          "captures": {
            "0": {
              "name": "punctuation.definition.comment.xenon"
            }
          },
          "patterns": [
            {
              "include": "#suppression"
            }
          ]
        },
        {
          "name": "comment.line.double-slash.xenon",
          "begin": "//",
          "end": "$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.xenon"
            }
          },
          "patterns": [
            {
              "include": "#suppression"
            }
          ]
        }
      ]
    },
    "suppression": {
      "match": "\\b(xenon-allow)\\s+((?:X\\d{4}[\\s,]*)+)",
      "captures": {
        "1": {
          "name": "keyword.other.suppression.xenon"
        },
        "2": {
          "name": "constant.other.error-code.xenon"
        }
      }
    },
    "strings": {
      "patterns": [
        {
          "name": "string.template.xenon",
          "begin": "\\$'",
          "end": "'|(?=$)",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.template.begin.xenon"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.template.end.xenon"
            }
          },
          "patterns": [
            {
              "include": "#escapes"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "name": "string.quoted.single.xenon",
          "begin": "'",
          "end": "'|(?=$)",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.xenon"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.xenon"
            }
          },
          "patterns": [
            {
              "include": "#escapes"
            }
          ]
        },
        {
          "name": "invalid.illegal.string.double.xenon",
          "match": "\"(?:[^\"\\\\\\n]|\\\\.)*\"?"
        },
        {
          "name": "invalid.illegal.string.backtick.xenon",
          "match": "`(?:[^`\\\\]|\\\\.)*`?"
        }
      ]
    },
    "escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.xenon",
          "match": "\\\\(?:[nrt0bfv'\\\\{}\\\"`$]|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|u\\{[0-9A-Fa-f]{1,6}\\})"
        },
        {
          "name": "invalid.illegal.escape.xenon",
          "match": "\\\\."
        }
      ]
    },
    "interpolation": {
      "name": "meta.template.expression.xenon",
      "contentName": "meta.embedded.line.xenon",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.template-expression.begin.xenon"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.template-expression.end.xenon"
        }
      },
      "patterns": [
        {
          "include": "#code"
        }
      ]
    },
    "braces": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.block.begin.xenon"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.xenon"
        }
      },
      "patterns": [
        {
          "include": "#code"
        }
      ]
    },
    "regex": {
      "name": "string.regexp.xenon",
      "match": "(~/)((?:[^/\\\\\\[\\n]|\\\\.|\\[(?:[^\\]\\\\\\n]|\\\\.)*\\])+)(/)([dgimsuvy]*)",
      "captures": {
        "1": {
          "name": "punctuation.definition.string.begin.xenon"
        },
        "2": {
          "patterns": [
            {
              "name": "constant.character.escape.regexp.xenon",
              "match": "\\\\."
            },
            {
              "name": "constant.other.character-class.regexp.xenon",
              "match": "\\[(?:[^\\]\\\\]|\\\\.)*\\]"
            },
            {
              "name": "keyword.operator.quantifier.regexp.xenon",
              "match": "[*+?]|\\{\\d+(?:,\\d*)?\\}"
            },
            {
              "name": "keyword.control.anchor.regexp.xenon",
              "match": "[$^]|\\\\b"
            }
          ]
        },
        "3": {
          "name": "punctuation.definition.string.end.xenon"
        },
        "4": {
          "name": "keyword.other.flag.regexp.xenon"
        }
      }
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.xenon",
          "match": "\\b0[xX][0-9A-Fa-f_]+\\b"
        },
        {
          "name": "constant.numeric.binary.xenon",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.octal.xenon",
          "match": "\\b0[oO][0-7_]+\\b"
        },
        {
          "name": "constant.numeric.decimal.xenon",
          "match": "(?:\\b\\d(?:_?\\d)*(?:\\.(?!\\.)\\d(?:_?\\d)*)?|\\.\\d(?:_?\\d)*)(?:[eE][+-]?\\d(?:_?\\d)*)?\\b"
        }
      ]
    },
    "package": {
      "match": "\\b(package)\\b(?:\\s+([\\w.]+))?",
      "captures": {
        "1": {
          "name": "keyword.other.package.xenon"
        },
        "2": {
          "name": "entity.name.namespace.xenon"
        }
      }
    },
    "import": {
      "patterns": [
        {
          "match": "\\b(import)\\s+((?:[A-Za-z_$][\\w$]*\\.)*)([A-Za-z_$][\\w$]*|\\*)(?=\\s*(?:;|$))",
          "captures": {
            "1": {
              "name": "keyword.control.import.xenon"
            },
            "2": {
              "name": "entity.name.namespace.xenon"
            },
            "3": {
              "name": "entity.name.type.xenon"
            }
          }
        },
        {
          "begin": "\\b(import)\\b",
          "end": "(?=;|$)",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.import.xenon"
            }
          },
          "patterns": [
            {
              "name": "keyword.control.from.xenon",
              "match": "\\b(?:from|as)\\b"
            },
            {
              "name": "keyword.operator.wildcard.xenon",
              "match": "\\*"
            },
            {
              "include": "#strings"
            },
            {
              "name": "variable.other.readwrite.alias.xenon",
              "match": "[A-Za-z_$][\\w$]*"
            },
            {
              "include": "#punctuation"
            }
          ]
        }
      ]
    },
    "native": {
      "match": "\\b(native)\\s*(\\()\\s*('[^'\\n]*')\\s*(\\))",
      "captures": {
        "1": {
          "name": "storage.modifier.xenon"
        },
        "2": {
          "name": "punctuation.section.parens.begin.xenon"
        },
        "3": {
          "name": "string.quoted.single.xenon"
        },
        "4": {
          "name": "punctuation.section.parens.end.xenon"
        }
      }
    },
    "type-declaration": {
      "patterns": [
        {
          "match": "\\b(class|interface|enum)\\s+([A-Za-z_$][\\w$]*)",
          "captures": {
            "1": {
              "name": "storage.type.$1.xenon"
            },
            "2": {
              "name": "entity.name.type.$1.xenon"
            }
          }
        },
        {
          "match": "\\b(extends|implements)\\b",
          "name": "storage.modifier.$1.xenon"
        }
      ]
    },
    "typedef": {
      "match": "\\b(typedef)\\s+([A-Za-z_$][\\w$]*)",
      "captures": {
        "1": {
          "name": "storage.type.typedef.xenon"
        },
        "2": {
          "name": "entity.name.type.alias.xenon"
        }
      }
    },
    "function-declaration": {
      "match": "\\b(function)\\b(?:\\s+(?:(get|set)\\s+(?=[A-Za-z_$][\\w$]*))?(operator\\s*\\+|[A-Za-z_$][\\w$]*))?",
      "captures": {
        "1": {
          "name": "storage.type.function.xenon"
        },
        "2": {
          "name": "storage.type.property.xenon"
        },
        "3": {
          "name": "entity.name.function.xenon"
        }
      }
    },
    "destructor": {
      "match": "(~)\\s*([A-Z][\\w$]*)(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "punctuation.definition.destructor.xenon"
        },
        "2": {
          "name": "entity.name.function.destructor.xenon"
        }
      }
    },
    "variable-declaration": {
      "patterns": [
        {
          "match": "\\b(var|const|using)\\s+(?!(?:namespace|use|with|yield|let|goto)\\b)([A-Za-z_$][\\w$]*)",
          "captures": {
            "1": {
              "name": "storage.type.$1.xenon"
            },
            "2": {
              "name": "variable.other.declaration.xenon"
            }
          }
        },
        {
          "match": "\\b(final)\\s+(?!(?:class|interface|enum|function|typedef|public|private|protected|internal|static|inline|abstract|override|dynamic|async|native|final)\\b)([A-Za-z_$][\\w$]*)",
          "captures": {
            "1": {
              "name": "storage.type.final.xenon"
            },
            "2": {
              "name": "variable.other.declaration.xenon"
            }
          }
        }
      ]
    },
    "for-header": {
      "begin": "\\b(for)\\s*(\\()",
      "end": "\\)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.loop.xenon"
        },
        "2": {
          "name": "punctuation.section.parens.begin.xenon"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.parens.end.xenon"
        }
      },
      "patterns": [
        {
          "name": "keyword.control.loop.xenon",
          "match": "\\b(?:of|step)\\b"
        },
        {
          "include": "#code"
        }
      ]
    },
    "parens": {
      "begin": "\\(",
      "end": "\\)",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.parens.begin.xenon"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.parens.end.xenon"
        }
      },
      "patterns": [
        {
          "include": "#code"
        }
      ]
    },
    "dynamic-type": {
      "match": "(?<=:)\\s*(\\*)",
      "captures": {
        "1": {
          "name": "support.type.dynamic.xenon"
        }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "variable.other.property.xenon",
          "match": "(?<=[\\w$)\\]]\\.|\\?\\.)(?:package|import|class|interface|enum|typedef|extends|implements|function|var|const|final|using|public|private|protected|internal|static|inline|abstract|override|dynamic|async|native|if|else|switch|case|default|while|do|for|in|break|continue|return|throw|try|catch|finally|new|this|super|is|as|typeof|delete|await|true|false|null|undefined|void|namespace|use|with|yield|let|goto)\\b"
        },
        {
          "name": "storage.modifier.const.xenon",
          "match": "\\bconst\\b(?=\\s*(?:\\{|;|$|//))"
        },
        {
          "name": "keyword.control.conditional.xenon",
          "match": "\\b(?:if|else|switch|case|default)\\b"
        },
        {
          "name": "keyword.control.loop.xenon",
          "match": "\\b(?:while|do|for|break|continue)\\b"
        },
        {
          "name": "keyword.control.flow.xenon",
          "match": "\\b(?:return|throw|await)\\b"
        },
        {
          "name": "keyword.control.exception.xenon",
          "match": "\\b(?:try|catch|finally)\\b"
        },
        {
          "name": "keyword.operator.expression.xenon",
          "match": "\\b(?:new|is|as|typeof|delete|in)\\b"
        },
        {
          "name": "storage.modifier.xenon",
          "match": "\\b(?:public|private|protected|internal|static|inline|abstract|override|dynamic|async|native|final)\\b"
        },
        {
          "name": "storage.type.xenon",
          "match": "\\b(?:function|var|const|using|class|interface|enum|typedef)\\b"
        },
        {
          "name": "variable.language.xenon",
          "match": "\\b(?:this|super)\\b"
        },
        {
          "name": "support.function.trace.xenon",
          "match": "\\btrace\\b"
        },
        {
          "name": "invalid.illegal.reserved.xenon",
          "match": "\\b(?:namespace|use|with|yield|let|goto)\\b"
        }
      ]
    },
    "builtin-types": {
      "patterns": [
        {
          "name": "support.type.primitive.xenon",
          "match": "\\b(?:int|uint|void|Float|String|Boolean|Int|UInt|Bool|Void|Any)\\b"
        },
        {
          "name": "support.type.builtin.xenon",
          "match": "\\b(?:Object|Array|Function|Promise|Class|RegExp)\\b"
        },
        {
          "name": "support.class.exception.xenon",
          "match": "\\b(?:Exception|ArgumentException|TypeException|RangeException|StateException|NotImplementedException)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.xenon",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "name": "constant.language.null.xenon",
          "match": "\\bnull\\b"
        },
        {
          "name": "constant.language.undefined.xenon",
          "match": "\\bundefined\\b"
        },
        {
          "name": "variable.other.constant.xenon",
          "match": "\\b[A-Z][A-Z0-9_]+\\b(?!\\s*[.(<])"
        }
      ]
    },
    "types": {
      "name": "entity.name.type.xenon",
      "match": "\\b[A-Z][\\w$]*\\b"
    },
    "function-call": {
      "match": "([A-Za-z_$][\\w$]*)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.call.xenon"
        }
      }
    },
    "operators": {
      "patterns": [
        {
          "name": "storage.type.function.arrow.xenon",
          "match": "=>|->"
        },
        {
          "name": "keyword.operator.spread.xenon",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.range.xenon",
          "match": "\\.\\.=?"
        },
        {
          "name": "keyword.operator.optional.xenon",
          "match": "\\?\\."
        },
        {
          "name": "keyword.operator.assignment.compound.xenon",
          "match": ">>>=|<<=|>>=|\\*\\*=|&&=|\\|\\|=|\\?\\?=|[-+*/%&|^]="
        },
        {
          "name": "keyword.operator.comparison.xenon",
          "match": "===|!==|==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.xenon",
          "match": "&&|\\|\\||\\?\\?|!"
        },
        {
          "name": "keyword.operator.bitwise.xenon",
          "match": ">>>|<<|>>|[&|^~]"
        },
        {
          "name": "keyword.operator.increment.xenon",
          "match": "\\+\\+|--"
        },
        {
          "name": "keyword.operator.arithmetic.xenon",
          "match": "\\*\\*|[-+*/%]"
        },
        {
          "name": "keyword.operator.assignment.xenon",
          "match": "="
        },
        {
          "name": "keyword.operator.ternary.xenon",
          "match": "\\?|:"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.xenon",
          "match": ";"
        },
        {
          "name": "punctuation.separator.comma.xenon",
          "match": ","
        },
        {
          "name": "punctuation.accessor.xenon",
          "match": "\\."
        }
      ]
    }
  }
}
