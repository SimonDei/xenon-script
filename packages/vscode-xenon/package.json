{
  "name": "vscode-xenon",
  "displayName": "XenonScript",
  "description": "XenonScript (.xn): syntax highlighting, diagnostics with quick fixes, hover, go to definition, completion, signature help, references, rename and outline",
  "version": "0.10.37",
  "publisher": "xenon",
  "license": "CC0-1.0",
  "icon": "icons/logo.png",
  "private": true,
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/xenon.json"
  ],
  "contributes": {
    "languages": [
      {
        "id": "xenon",
        "aliases": [
          "Xenon",
          "xenon"
        ],
        "extensions": [
          ".xn"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/xn-file.svg",
          "dark": "./icons/xn-file.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "xenon",
        "scopeName": "source.xenon",
        "path": "./syntaxes/xenon.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "xenon.restartServer",
        "title": "Restart Language Server",
        "category": "XenonScript"
      }
    ],
    "configuration": {
      "title": "XenonScript",
      "properties": {
        "xenon.bunPath": {
          "type": "string",
          "default": "bun",
          "description": "The Bun executable that runs the language server."
        },
        "xenon.server.path": {
          "type": "string",
          "default": "",
          "description": "A compiler's `src/cli.ts` to run as the language server (`bun <path> lsp`) instead of the bundled one, e.g. a checkout of the compiler."
        }
      }
    },
    "configurationDefaults": {
      "[xenon]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "off",
          "strings": "off"
        },
        "editor.suggestOnTriggerCharacters": true
      }
    }
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "package": "bun scripts/build.ts && bunx @vscode/vsce@3.6.2 package --no-dependencies --allow-missing-repository --out xenon.vsix"
  },
  "devDependencies": {
    "@types/vscode": "1.82.0",
    "vscode-languageclient": "9.0.1"
  }
}
