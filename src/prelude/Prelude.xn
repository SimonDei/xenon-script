// The Xenon prelude: built-in classes and interfaces, auto-imported into every file.
// This is the only Xenon code allowed to see JavaScript's `Error` classes.
// Everything lives in one file (one JS module) because `Exception.from` creates the
// subclasses while they extend `Exception`: separate modules would form an import cycle.
package xenon {
  /** Capitalized alias of the dynamic type `*`. */
  public typedef Any = *


  /** `Null<int>` is `int?`: an `int` that may also be `null`. (`Null<String>` is just `String`.) */
  public typedef Null<T> = T?

  /**
   * A value cleaned up by hand: `using` calls `dispose()` when its block ends (or call it yourself).
   * Such a class has no destructor; a class with a destructor is scoped instead (destroyed when the
   * scope owning the value ends). A class is one or the other.
   */
  public interface IDisposable {
    function dispose():Void
  }

  /** `IDisposable` with an async `dispose()`: `await using`, `await x.dispose()`. */
  public interface IAsyncDisposable {
    function dispose():Promise<Void>
  }

  /**
   * An attribute class: `[Name(…)]` before a class, method or field creates one, readable at run time
   * with `Attributes`. Its constructor takes the positional arguments; `name = value` arguments set
   * public fields or setters afterwards. Arguments are compile-time constants.
   */
  public interface IAttribute {
    /**
     * Optional (the only interface member an implementation may leave out): an attribute defining it
     * changes the methods it is used on. When the class is defined, the method is replaced by what
     * this returns for it; call `method.apply(this, args)` in a `function` expression (whose `this`
     * is the object the method is called on) to run the original. An instance of the attribute is
     * created for this when the class is defined (separate from the ones `Attributes` returns).
     * Nearest the method wraps first: `[A, B]` gives `A.wrap(B.wrap(method))`. On classes and fields
     * it isn't called.
     */
    function wrap(method:Function, name:String):Function
  }

  /** Where an attribute may be used (see `Usage`). */
  public enum AttributeTarget { Class, Method, Field }

  /**
   * On an attribute class: where it may be used (`[Usage(AttributeTarget.Method, AttributeTarget.Field)]`;
   * without `Usage`, on classes, methods and fields) and whether one declaration may carry it more
   * than once (`multiple = true`). Read by the compiler only.
   */
  public class Usage implements IAttribute {
    public final targets:Array<AttributeTarget>
    public var multiple:Bool = false

    public function Usage(...targets:Array<AttributeTarget>) {
      this.targets = targets
    }
  }

  /** Marks a class, method or field as deprecated: every use elsewhere is warning X0873 with the message. Compile time only. */
  public class Deprecated implements IAttribute {
    public final message:String

    public function Deprecated(message:String = '') {
      this.message = message
    }
  }

  /**
   * The result matters: a statement that drops it (`text.trim()` alone) is warning X0875, with the
   * message if one is given. On a method: its calls; on a class: calls returning one and `new`.
   * `void f()` discards on purpose. Compile time only.
   */
  [Usage(AttributeTarget.Method, AttributeTarget.Class)]
  public class NoDiscard implements IAttribute {
    public final message:String

    public function NoDiscard(message:String = '') {
      this.message = message
    }
  }

  /**
   * Reads the attributes of classes and their members at run time: `Attributes.of(UserController, Route)`.
   * Only the class asked about counts (attributes aren't inherited). Each attribute is created on
   * the first lookup and then kept, so lookups return the same objects.
   */
  public static class Attributes {
    /** Where a class keeps the function creating its attributes (written by the compiler). */
    public static final KEY:Symbol = Symbol('xenon.attributes')
    private static final created:* = new WeakMap()

    /** The class's attributes of this kind. */
    public static function of<T>(type:Class<*>, kind:Class<T>):Array<T> {
      return select(own(type).type, kind)
    }

    /** The class's first attribute of this kind, or `null`. */
    public static function first<T>(type:Class<*>, kind:Class<T>):T? {
      var all:Array<T> = of(type, kind)
      return all.length > 0 ? all[0] : null
    }

    /** The attributes of this kind on a method or field (static or not) of the class. */
    public static function ofMember<T>(type:Class<*>, member:String, kind:Class<T>):Array<T> {
      var list:* = own(type).members[member]
      return list == null ? [] : select(list, kind)
    }

    /** The class's methods and fields that have attributes. */
    public static function members(type:Class<*>):Array<String> {
      return Object.keys(own(type).members)
    }

    private static function own(type:Class<*>):* {
      var t:* = type
      if (!Object.hasOwn(t, KEY)) return { type: [], members: {} }
      var found:* = created.get(t)
      if (found == null) {
        found = t[KEY]()
        created.set(t, found)
      }
      return found
    }

    private static function select<T>(list:*, kind:Class<T>):Array<T> {
      var result:Array<T> = []
      for (var a:* of list) {
        if (var x:T = a as kind) result.push(x)
      }
      return result
    }
  }

  /**
   * JavaScript's iterable protocol: arrays, strings, `Set`, `Map`, and `Iterator` implement it, and
   * user classes become iterable by implementing `[Symbol.iterator]`.
   */
  public interface Iterable<T> {
    function [Symbol.iterator]():Iterator<T>
  }

  public class Exception extends Error {
    /** The underlying error or thrown value, if any. */
    public final cause:*

    public function Exception(message:String = '', cause:* = null) {
      super(message)
      this.cause = cause
      this.name = this.constructor.name
    }

    /** Normalizes anything thrown (by Xenon or JavaScript) into an `Exception`. */
    public static function from(value:*):Exception {
      if (var known:Exception = value as Exception) return known
      var e:Exception
      if (value is TypeError) e = new TypeException(value.message, value)
      else if (value is RangeError) e = new RangeException(value.message, value)
      else if (value is Error) e = new Exception(value.message, value)
      else return new Exception('Non-error value thrown: ' + String(value), value)
      e.stack = value.stack
      return e
    }

    override public function toString():String {
      var text:String = String(this.name) + ': ' + String(this.message)
      if (cause != null && !(cause is Error)) text += ' (caused by ' + String(cause) + ')'
      return text
    }
  }

  /** An argument has an invalid value. */
  public class ArgumentException extends Exception {}

  /** A value has the wrong type (also used for JavaScript `TypeError`s). */
  public class TypeException extends Exception {}

  /** A value or index is out of range (also used for JavaScript `RangeError`s). */
  public class RangeException extends Exception {}

  /** The object is in the wrong state for this call. */
  public class StateException extends Exception {}

  /** The called member has no implementation (abstract stubs). */
  public class NotImplementedException extends Exception {}
}
