// Standard library: JavaScript's `Object`. The `Object` type itself stays built into the compiler
// (every value but `Void` fits it, `{ … }` literals, `o['key']` indexing); this class supplies the
// statics (`Object.keys(…)` & co.) and the instance members every object inherits from
// `Object.prototype`: they are available on all class instances, shapes and `Object` values, and a
// class redefining one needs `override`. (`new Object()` still makes an empty object.)
//
// Typing: keys are `String`s, values are `*` (an object has no single value type), entries are
// `Tuple<String, *>`.
// `freeze` & co. return their argument with its own type; `assign` returns `*`, since the result
// has the members of all its arguments. Every value fits `Object`, `null` included, but
// `Object.keys(null)` throws a `TypeException`: check for `null` first.
// Members of an `Object` value that aren't declared here stay untyped (`o.anything` is `*`).
// Not declared: `defineProperties`,
// `getOwnPropertyDescriptors`, `getOwnPropertySymbols` (no `Symbol` yet); use `(object as *)`.
package xenon {
  public native class Object {
    // ---- instance members (Object.prototype) ----
    /** Text for the object; `'[object Object]'` unless a class overrides it. String concatenation calls it. */
    function toString():String
    function toLocaleString():String
    /** The primitive value of the object (the object itself unless overridden); used by comparisons. */
    function valueOf():*
    /** Prefer `Object.hasOwn(o, key)`, which also works for objects without a prototype. */
    function hasOwnProperty(key:String):Boolean
    function hasOwnProperty(index:Float):Boolean
    /** Is this object somewhere in `object`'s prototype chain? */
    function isPrototypeOf(object:*):Boolean
    function propertyIsEnumerable(key:String):Boolean

    // ---- reading ----
    /** The own enumerable property names. */
    static function keys(object:Object):Array<String>
    /** The own enumerable property values. */
    static function values(object:Object):Array<*>
    /** The own enumerable `[key, value]` pairs. */
    static function entries(object:Object):Array<Tuple<String, *>>
    /** All own property names, enumerable or not (but no symbols). */
    static function getOwnPropertyNames(object:Object):Array<String>
    /** Does `object` have `key` itself, not through its prototype? Safer than `key in object`. */
    static function hasOwn(object:Object, key:String):Boolean
    static function hasOwn(object:Object, index:Float):Boolean
    /** The descriptor (`{ value, writable, enumerable, configurable }` or `{ get, set, … }`), `undefined` when missing. */
    static function getOwnPropertyDescriptor(object:Object, key:String):*
    /** `SameValue`: like `==`, but `NaN` equals `NaN` and `0` differs from `-0`. */
    static function is(a:*, b:*):Boolean

    // ---- building ----
    /**
     * Copies the own enumerable properties of the sources onto `target` and returns `target`:
     * `var merged:Point = Object.assign({}, defaults, overrides)`.
     */
    static function assign(target:Object, ...sources:Array<Object>):*
    /** `{ [key]: value, … }` from `[key, value]` pairs: an array, a map or an iterator (`map.entries()`). */
    static function fromEntries<V>(entries:Iterable<Tuple<*, V>>):Object
    /** From pairs built at runtime (`items.map(i => [i.id, i])`). */
    static function fromEntries(entries:Iterable<Array<*>>):Object
    /** A new object whose prototype is `prototype`; `Object.create(null)` has none. */
    static function create(prototype:Object?):Object
    /** `descriptors` maps property names to descriptors, as for `defineProperty`. */
    static function create(prototype:Object?, descriptors:Object):Object
    /**
     * Groups the items by the key `callback` returns: `{ even: [2, 4], odd: [1, 3] }`. Keys are
     * `String`s (JS would convert numbers: write `String(n % 2)`). The result has no prototype.
     */
    static function groupBy<T>(items:Array<T>, callback:(item:T, index:int) -> String):Object
    static function groupBy<T>(items:Set<T>, callback:(item:T, index:int) -> String):Object
    static function groupBy<T>(items:Iterator<T>, callback:(item:T, index:int) -> String):Object
    static function defineProperty<T>(object:T, key:String, descriptor:*):T

    // ---- prototypes ----
    /** `null` at runtime for objects without a prototype. */
    static function getPrototypeOf(object:Object):Object?
    static function setPrototypeOf<T>(object:T, prototype:Object):T

    // ---- locking ----
    /** Makes `object` read-only (shallow) and returns it. Later writes throw a `TypeException` (the output modules are strict). */
    static function freeze<T>(object:T):T
    static function isFrozen(object:Object):Boolean
    /** No properties can be added or removed, but the existing ones stay writable. */
    static function seal<T>(object:T):T
    static function isSealed(object:Object):Boolean
    /** No properties can be added. */
    static function preventExtensions<T>(object:T):T
    static function isExtensible(object:Object):Boolean
  }
}
