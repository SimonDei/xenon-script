// Standard library: things `for … of` can loop over. Arrays, strings, `Set`, `Map` and `Iterator`
// implement it, and so can any class: declare `function [Symbol.iterator]():Iterator<T>` and
// `implements Iterable<T>`. The method usually hands out an existing iterator
// (`return items.values()`); `Iterator.from({ next: … })` builds one by hand.
//
// A native interface: classes get no runtime marker for it, and `x is Iterable` tests whether
// `x[Symbol.iterator]` is a function, so it is also true for JavaScript iterables.
package xenon {
  public native interface Iterable<T> {
    function [Symbol.iterator]():Iterator<T>
  }
}
