// prelude in programs built with Xenon may be distributed under any terms.
// Standard library: members of the primitive `Boolean` (JavaScript `Boolean.prototype`).
// Conversions are written `Boolean(x)` (a built-in cast), never `new Boolean(x)`: wrapper
// objects are always truthy and never `==` a primitive, so the constructor is hidden.
package xenon {
  /** Short alias of `Boolean`. */
  public typedef Bool = Boolean

  public native class Boolean {
    private function Boolean()

    /** `'true'` or `'false'`. */
    function toString():String

    /** The primitive value itself. */
    function valueOf():Boolean
  }
}
