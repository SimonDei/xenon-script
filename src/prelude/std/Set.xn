// Standard library: JavaScript's `Set<T>`: a collection of unique values in insertion order.
//
// Values are compared like `==` in Xenon, except that NaN equals NaN (`new Set([NaN, NaN]).size` is 1).
// Iterate with `for (var v:T of set)`; the loop variable is typed `T`.
package xenon {
  public native class Set<T> implements Iterable<T> {
    function Set()
    /** A set of the distinct values of an array. */
    function Set(values:Array<T>)
    /** A copy of another set. */
    function Set(other:Set<T>)

    /** How many values the set holds. */
    final size:Int
    /** Adds `value` unless it is already there; returns the set, so calls chain. */
    function add(value:T):Set<T>
    function has(value:T):Bool const
    /** Removes `value`; returns whether it was there. */
    function delete(value:T):Bool
    function clear():Void
    /** Calls `callback(value, value, set)` for each value in insertion order (the value is passed twice, as in `Map.forEach`). */
    function forEach(callback:(value:T, key:T, set:const Set<T>) -> Void):Void const

    /** The values in insertion order (single-use). */
    function values():Iterator<T> const
    /** Same as `values()`: a set's keys are its values. */
    function keys():Iterator<T> const
    /** `[value, value]` pairs, mirroring `Map.entries()`. */
    function entries():Iterator<Tuple<T, T>> const

    // Set algebra: each returns a new set and leaves both operands unchanged.
    function union(other:Set<T>):Set<T> const
    function intersection(other:Set<T>):Set<T> const
    /** Values in this set but not in `other`. */
    function difference(other:Set<T>):Set<T> const
    /** Values in exactly one of the two sets. */
    function symmetricDifference(other:Set<T>):Set<T> const
    function isSubsetOf(other:Set<T>):Bool const
    function isSupersetOf(other:Set<T>):Bool const
    function isDisjointFrom(other:Set<T>):Bool const
  }
}
