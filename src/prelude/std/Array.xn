// Standard library: members of `Array<T>` (JavaScript `Array`). The type itself is built into the
// compiler (literals `[1, 2]`, indexing `a[i]`, `for … of`, `[a, b] = …`); this class gives it its
// members, with `T` as the element type. A bare `Array` is `Array<*>`.
//
// Typing: positions and counts are `int`; a result that may be missing (`pop()` on an empty array,
// `find` without a hit, `at` out of range) is `T?`: `nums.pop() ?? 0`, `if (var n:int = nums.pop())`.
// (Indexing `a[i]` is typed `T` and not checked.)
// `sort` comparators return a `Float` (an `int` fits). `new Array<T>()` is unchecked.
// Not declared: `copyWithin`, `flat` with a depth (`flat()` returns `Array<*>`), `toLocaleString`
// with arguments, `Array.fromAsync`; use `(array as *)`.
package xenon {
  public native class Array<T> implements Iterable<T> {
    // ---- statics ----
    /** Is `value` an array? (A runtime test; `x is Array` is the same.) */
    static function isArray(value:*):Boolean
    static function of<T>(...items:Array<T>):Array<T>
    /** A new array from an array, a set or an iterator. */
    static function from<T>(source:Array<T>):Array<T>
    static function from<T>(source:Set<T>):Array<T>
    static function from<T>(source:Iterator<T>):Array<T>
    /** Anything `for … of` can go through: a map's entries, a DOM `HTMLCollection` or `NodeList`. */
    static function from<T>(source:Iterable<T>):Array<T>
    /** The characters of a string. */
    static function from(source:String):Array<String>
    /** Maps while copying: `Array.from(names, (n, i) => …)`. */
    static function from<T, U>(source:Array<T>, mapper:(item:T, index:int) -> U):Array<U>
    static function from<T, U>(source:Set<T>, mapper:(item:T, index:int) -> U):Array<U>
    static function from<T, U>(source:Iterator<T>, mapper:(item:T, index:int) -> U):Array<U>
    static function from<T, U>(source:Iterable<T>, mapper:(item:T, index:int) -> U):Array<U>
    /** An array-like object: `Array.from({ length: 3 }, (_, i) => i * 2)`. */
    static function from<U>(source:{ length:int }, mapper:(item:*, index:int) -> U):Array<U>

    // ---- size ----
    /** Number of elements. Assigning a smaller value cuts the array; a larger one adds empty slots. */
    var length:int

    // ---- adding and removing (these change the array) ----
    /** Appends items; returns the new length. */
    function push(...items:Array<T>):int
    /** Removes and returns the last element; `null` if the array is empty. */
    function pop():T?
    /** Removes and returns the first element; `null` if the array is empty. */
    function shift():T?
    /** Inserts items at the start; returns the new length. */
    function unshift(...items:Array<T>):int
    /** Removes everything from `start` on; returns the removed elements. */
    function splice(start:int):Array<T>
    function splice(start:int, deleteCount:int):Array<T>
    /** Removes `deleteCount` elements at `start` and inserts `items` there; returns the removed ones. */
    function splice(start:int, deleteCount:int, ...items:Array<T>):Array<T>
    /** Reverses in place; returns the array itself. */
    function reverse():Array<T>
    /** Sorts in place (by the strings' order, `10 < 9`!); give a comparator for numbers. */
    function sort():Array<T>
    /** Sorts in place; `compare(a, b)` is negative, 0 or positive. Returns the array itself. */
    function sort(compare:(a:T, b:T) -> Float):Array<T>
    function fill(value:T):Array<T>
    function fill(value:T, start:int):Array<T>
    function fill(value:T, start:int, end:int):Array<T>

    // ---- copies (the array stays unchanged) ----
    function slice():Array<T>
    function slice(start:int):Array<T>
    function slice(start:int, end:int):Array<T>
    function concat(...others:Array<Array<T>>):Array<T>
    function toReversed():Array<T>
    function toSorted():Array<T>
    function toSorted(compare:(a:T, b:T) -> Float):Array<T>
    function toSpliced(start:int, deleteCount:int, ...items:Array<T>):Array<T>
    /** A copy with the element at `index` replaced (throws a `RangeError` out of range). */
    function with(index:int, value:T):Array<T>
    /** One level of nesting removed; the result's elements are untyped. */
    function flat():Array<*>

    // ---- reading ----
    /** Like `a[index]`, but negative indexes count from the end: `a.at(-1)` is the last element. */
    function at(index:int):T?
    function indexOf(item:T, from:int = 0):int
    function lastIndexOf(item:T):int
    function lastIndexOf(item:T, from:int):int
    function includes(item:T, from:int = 0):Boolean
    /** The elements as text, joined by `separator`. */
    function join(separator:String = ','):String
    function toString():String

    // ---- callbacks: `(item, index, array)`; shorter parameter lists are fine ----
    function forEach(callback:(item:T, index:int, array:Array<T>) -> Void):void
    function map<U>(callback:(item:T, index:int, array:Array<T>) -> U):Array<U>
    function flatMap<U>(callback:(item:T, index:int, array:Array<T>) -> Array<U>):Array<U>
    function filter(test:(item:T, index:int, array:Array<T>) -> Boolean):Array<T>
    function some(test:(item:T, index:int, array:Array<T>) -> Boolean):Boolean
    function every(test:(item:T, index:int, array:Array<T>) -> Boolean):Boolean
    /** The first element passing `test`, or `null`. */
    function find(test:(item:T, index:int, array:Array<T>) -> Boolean):T?
    /** Its position, or -1. */
    function findIndex(test:(item:T, index:int, array:Array<T>) -> Boolean):int
    function findLast(test:(item:T, index:int, array:Array<T>) -> Boolean):T?
    function findLastIndex(test:(item:T, index:int, array:Array<T>) -> Boolean):int
    /** Folds from the left without a start value (throws a `TypeError` on an empty array). */
    function reduce(callback:(accumulator:T, item:T, index:int, array:Array<T>) -> T):T
    function reduce<U>(callback:(accumulator:U, item:T, index:int, array:Array<T>) -> U, initial:U):U
    function reduceRight(callback:(accumulator:T, item:T, index:int, array:Array<T>) -> T):T
    function reduceRight<U>(callback:(accumulator:U, item:T, index:int, array:Array<T>) -> U, initial:U):U

    // ---- iterators ----
    function keys():Iterator<int>
    function values():Iterator<T>
    /** `[index, item]` pairs. */
    function entries():Iterator<Tuple<int, T>>
  }
}
