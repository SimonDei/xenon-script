// Standard library: JavaScript's `Math` object. A namespace (hidden constructor, static members).
//
// Typing: every result is `Float` (it can be NaN or leave the `int` range), including `floor`,
// `round`, `ceil` and `trunc`: wrap them in `int(…)` when you know the value fits. Only results
// that are always whole 32-bit numbers (`clz32`, `imul`) are `int`.
// `constexpr`: every function but `random` runs at compile time on constant arguments, and the
// constants are `inline` (`Math.PI * 2` in an `inline` constant is folded).
// Not declared (too new to rely on): `f16round`, `sumPrecise`; use `(Math as *)`.
package xenon {
  public native class Math {
    private function Math()

    static inline const E:Float = 2.718281828459045
    static inline const LN2:Float = 0.6931471805599453
    static inline const LN10:Float = 2.302585092994046
    static inline const LOG2E:Float = 1.4426950408889634
    static inline const LOG10E:Float = 0.4342944819032518
    static inline const PI:Float = 3.141592653589793
    static inline const SQRT2:Float = 1.4142135623730951
    /** √½ */
    static inline const SQRT1_2:Float = 0.7071067811865476

    static constexpr function abs(x:Float):Float
    /** −1, 0 or 1 for the sign of `x` (NaN stays NaN). */
    static constexpr function sign(x:Float):Float
    /** Rounds down: `floor(-1.5)` is -2. */
    static constexpr function floor(x:Float):Float
    /** Rounds up: `ceil(-1.5)` is -1. */
    static constexpr function ceil(x:Float):Float
    /** Rounds to the nearest integer, halves toward +∞: `round(-1.5)` is -1, `round(2.5)` is 3. */
    static constexpr function round(x:Float):Float
    /** Drops the fraction: `trunc(-1.5)` is -1. */
    static constexpr function trunc(x:Float):Float
    /** Nearest 32-bit float. */
    static constexpr function fround(x:Float):Float

    /** Largest argument; `-Infinity` without arguments, NaN if any argument is NaN. */
    static constexpr function max(...values:Array<Float>):Float
    /** Smallest argument; `Infinity` without arguments, NaN if any argument is NaN. */
    static constexpr function min(...values:Array<Float>):Float
    /** √(a² + b² + …) */
    static constexpr function hypot(...values:Array<Float>):Float
    static constexpr function pow(base:Float, exponent:Float):Float
    static constexpr function sqrt(x:Float):Float
    static constexpr function cbrt(x:Float):Float
    /** eˣ */
    static constexpr function exp(x:Float):Float
    /** eˣ − 1, accurate near 0. */
    static constexpr function expm1(x:Float):Float
    /** Natural logarithm. */
    static constexpr function log(x:Float):Float
    static constexpr function log2(x:Float):Float
    static constexpr function log10(x:Float):Float
    /** ln(1 + x), accurate near 0. */
    static constexpr function log1p(x:Float):Float

    static constexpr function sin(x:Float):Float
    static constexpr function cos(x:Float):Float
    static constexpr function tan(x:Float):Float
    static constexpr function asin(x:Float):Float
    static constexpr function acos(x:Float):Float
    static constexpr function atan(x:Float):Float
    /** Angle of the point (x, y): note the parameter order, `y` first. */
    static constexpr function atan2(y:Float, x:Float):Float
    static constexpr function sinh(x:Float):Float
    static constexpr function cosh(x:Float):Float
    static constexpr function tanh(x:Float):Float
    static constexpr function asinh(x:Float):Float
    static constexpr function acosh(x:Float):Float
    static constexpr function atanh(x:Float):Float

    /** A random number from 0 (included) up to 1 (excluded). */
    static function random():Float
    /** Leading zero bits of `x` as a 32-bit unsigned number (0–32). */
    static constexpr function clz32(x:Float):int
    /** 32-bit integer multiplication, wrapping around on overflow. */
    static constexpr function imul(a:int, b:int):int
  }
}
