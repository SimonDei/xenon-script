// Standard library: JavaScript's `RegExp`. Literals are written `~/pattern/flags` (see the lexer);
// `new RegExp(text, flags)` builds one at runtime.
//
// Typing: `exec` returns the match as `Array<String>` (index 0 is the whole match, then the capture
// groups; an unmatched group is `null`), or `null` when nothing matches. The extra properties of a
// match (`index`, `input`, `groups`, and `indices` with the `d` flag) aren't typed:
// `(match as *).groups.year`.
// A regex with the `g` or `y` flag remembers where it stopped (`lastIndex`), so `test` and `exec`
// give different answers on repeated calls with the same text. Reset it with `lastIndex = 0`.
// Not declared: the legacy statics (`RegExp.$1`, …), `compile`, `RegExp.escape` (too new) and the
// `Symbol.match`-style methods.
package xenon {
  public native class RegExp {
    /** From a pattern in text form: `new RegExp('^a+$', 'i')`. Flags are `d g i m s u v y`; invalid ones throw a `SyntaxError`. */
    function RegExp(pattern:String, flags:String = '')
    /** A copy of another regex, optionally with different flags. */
    function RegExp(source:RegExp)
    function RegExp(source:RegExp, flags:String)

    /** Is there a match anywhere in `text`? */
    function test(text:String):Boolean
    /** The match (see the file header), or `null`. With `g`/`y`, searches from `lastIndex`. */
    function exec(text:String):Array<String>?
    /** `'/pattern/flags'` */
    function toString():String

    /** The pattern text, without the slashes. */
    final source:String
    /** The flags in canonical order, e.g. `'gi'`. */
    final flags:String
    final global:Boolean
    final ignoreCase:Boolean
    final multiline:Boolean
    /** `.` also matches line breaks (`s` flag). */
    final dotAll:Boolean
    final unicode:Boolean
    final unicodeSets:Boolean
    final sticky:Boolean
    /** Match indices are recorded (`d` flag). */
    final hasIndices:Boolean

    /** Where the next `g`/`y` search starts. Assignable. */
    var lastIndex:int
  }
}
