// Standard library: JavaScript's `Iterator<T>`: what `values()`, `keys()` and `entries()` return.
//
// An iterator is single-use: once consumed (by `for … of`, `toArray()`, `next()`, …) it is empty.
// The helper methods (`map`, `filter`, `take`, …) are lazy: they produce a new iterator and only
// run when it is consumed.
// Not declared: `Iterator.concat` (too new), `return()` / `throw()`.
package klass {
  /** What `next()` returns: `done` is true once the iterator is finished (then `value` is `null`). */
  public typedef IteratorResult<T> = { done:Boolean, value:T }

  public native class Iterator<T> {
    // `Iterator` can't be constructed directly (it throws); get one from `values()`, `Iterator.from(…)`, …
    private function Iterator()

    /** An iterator over an array, a set, or another iterator (an iterator is returned as it is). */
    static function from<T>(source:Array<T>):Iterator<T>
    static function from<T>(source:Set<T>):Iterator<T>
    static function from<T>(source:Iterator<T>):Iterator<T>

    /** Advances the iterator: `{ done:false, value }` for the next value, then `{ done:true }`. */
    function next():IteratorResult<T>

    /** All remaining values, as an array. */
    function toArray():Array<T>
    function forEach(callback:(value:T, index:int) -> Void):void

    // lazy transformations (return a new iterator)
    function map<U>(mapper:(value:T, index:int) -> U):Iterator<U>
    function filter(test:(value:T, index:int) -> Boolean):Iterator<T>
    /** At most the first `limit` values. */
    function take(limit:int):Iterator<T>
    /** Everything after the first `count` values. */
    function drop(count:int):Iterator<T>
    /** Maps each value to an iterator and joins them. */
    function flatMap<U>(mapper:(value:T, index:int) -> Iterator<U>):Iterator<U>

    // consuming operations
    /** Folds without a start value (throws a `TypeError` on an empty iterator). */
    function reduce(reducer:(accumulator:T, value:T, index:int) -> T):T
    function reduce<U>(reducer:(accumulator:U, value:T, index:int) -> U, initial:U):U
    function some(test:(value:T, index:int) -> Boolean):Boolean
    function every(test:(value:T, index:int) -> Boolean):Boolean
    /** The first value passing `test`, or `null`. */
    function find(test:(value:T, index:int) -> Boolean):T
  }
}
