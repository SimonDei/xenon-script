package xenon {
  public typedef Executor<T> = (resolve:(value:T) -> Void, reject:(reason:*) -> Void) -> Void
  public typedef FulfilledExecutor<T, U> = (value:T) -> U

  public native class Promise<T> {
    function Promise(executor:Executor<T>)

    static function resolve<T>(value:T):Promise<T>
    static function resolve():Promise<Void>

    static function reject<T>(reason:*):Promise<T>

    static function all(iterable:Array<Promise<*>>):Promise<Array<*>>

    function then<U>(onFulfilled:FulfilledExecutor<T, U>):Promise<U>
    function then<U>(onFulfilled:FulfilledExecutor<T, U>, onRejected:(reason:*) -> U):Promise<U>

    function catch(onRejected:(reason:*) -> T):Promise<T>

    function finally(onFinally:() -> Void):Promise<T>
  }
}
