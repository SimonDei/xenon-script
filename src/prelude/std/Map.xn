// Standard library: JavaScript's `Map<K, V>`: key/value pairs in insertion order. Keys are compared
// like `==` in Xenon, except that NaN equals NaN; objects are compared by identity.
//
// Iterate with a destructuring loop: `for (var [key, value]:* of map)`, where `key` is a `K` and
// `value` a `V`. Without the pattern each element is an `Array<*>` pair (`[key, value]`).
// Typing: `get` returns `V?`, `null` for a missing key: `ages.get('ann') ?? 0`, or
// `if (var age:int = ages.get('ann')) …`. `new Map(pairs)` can't infer `K` and `V` from
// an array of `[key, value]` pairs: declare them, `var m:Map<String, int> = new Map(…)`.
// Not declared (too new): `getOrInsert`, `getOrInsertComputed`.
package xenon {
  public native class Map<K, V> implements Iterable<Array<*>> {
    /** The `[key, value]` pairs in insertion order: what `for … of` uses (`for (var [k, v]:* of map)` types them). */
    function [Symbol.iterator]():Iterator<Array<*>>

    function Map()
    /** From `[key, value]` pairs: `new Map([['a', 1], ['b', 2]])`. */
    function Map(pairs:Array<Array<*>>)
    /** A copy of another map. */
    function Map(other:Map<K, V>)

    /** Groups `items` by the key `callback` returns: `Map.groupBy(words, (w, i) => w.length)`. */
    static function groupBy<T, K>(items:Array<T>, callback:(item:T, index:int) -> K):Map<K, Array<T>>

    /** How many keys the map holds. */
    function get size():int
    /** The value for `key`, or `null` if there is none. */
    function get(key:K):V?
    /** Sets the value for `key` (replacing an old one); returns the map, so calls chain. */
    function set(key:K, value:V):Map<K, V>
    function has(key:K):Boolean
    /** Removes `key`; returns whether it was there. */
    function delete(key:K):Boolean
    function clear():void
    /** Calls `callback(value, key, map)` for each pair in insertion order. */
    function forEach(callback:(value:V, key:K, map:Map<K, V>) -> Void):void

    function keys():Iterator<K>
    function values():Iterator<V>
    /** `[key, value]` pairs. */
    function entries():Iterator<Array<*>>
  }
}
