// Browser: the abstract DOM base for nodes that contain character data.
package xenon {
  public abstract native class CharacterData extends Node {
    private function CharacterData()

    var data:String
    final length:Int
    final nextElementSibling:Element?
    final previousElementSibling:Element?

    function after(...nodes:Array<*>):Void
    function appendData(data:String):Void
    function before(...nodes:Array<*>):Void
    function deleteData(offset:Int, count:Int):Void
    function insertData(offset:Int, data:String):Void
    function remove():Void
    function replaceData(offset:Int, count:Int, data:String):Void
    function replaceWith(...nodes:Array<*>):Void
    function substringData(offset:Int, count:Int):String
  }
}
