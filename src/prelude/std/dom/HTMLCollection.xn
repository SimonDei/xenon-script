// Browser: the DOM's `HTMLCollection`, a live list of elements (`getElementsByTagName`,
// `children`): it follows changes to the tree. Browser-only: Bun has no DOM.
// Use it with `for (var e:Element of collection)`, `length`/`item(i)`, or `Array.from(collection)`
// for array methods (and to get a snapshot before changing the tree).
package xenon {
  public native class HTMLCollection implements Iterable<Element> {
    private function HTMLCollection()

    final length:Int
    /** The element at `index`, or `null` past the end. */
    function item(index:Int):Element?
    /** `list[index]`: like `item(index)`, the element at `index`, or `null` past the end. */
    function operator[](index:Int):Element?
    /** The element with this `id` or `name`, or `null`. */
    function namedItem(name:String):Element?
  }
}
