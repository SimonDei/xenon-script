// Browser: an HTML element. More specific HTML element classes inherit from this common interface.
package xenon {
  public native class HTMLElement extends Element {
    private function HTMLElement()

    // ---- global HTML attributes ----
    function get accessKey():String
    function set accessKey(value:String):void
    function get accessKeyLabel():String
    function get anchorElement():Element?
    /** Typed CSS declarations from the `style` attribute. */
    function get attributeStyleMap():*
    function get autocapitalize():String
    function set autocapitalize(value:String):void
    function get autocorrect():Boolean
    function set autocorrect(value:Boolean):void
    function get autofocus():Boolean
    function set autofocus(value:Boolean):void
    function get containerTiming():String
    function set containerTiming(value:String):void
    function get containerTimingIgnore():Boolean
    function set containerTimingIgnore(value:Boolean):void
    function get contentEditable():String
    function set contentEditable(value:String):void
    /** Custom `data-*` attributes, available through their camel-cased names. */
    function get dataset():*
    function get dir():String
    function set dir(value:String):void
    function get draggable():Boolean
    function set draggable(value:Boolean):void
    function get editContext():*
    function set editContext(value:*):void
    function get enterKeyHint():String
    function set enterKeyHint(value:String):void
    function get hidden():Boolean | String
    function set hidden(value:Boolean | String):void
    function get inert():Boolean
    function set inert(value:Boolean):void
    function get innerText():String
    function set innerText(value:String):void
    function get inputMode():String
    function set inputMode(value:String):void
    function get isContentEditable():Boolean
    function get lang():String
    function set lang(value:String):void
    function get nonce():String
    function set nonce(value:String):void
    function get outerText():String
    function set outerText(value:String):void
    function get popover():String?
    function set popover(value:String?):void
    function get spellcheck():Boolean
    function set spellcheck(value:Boolean):void
    function get tabIndex():int
    function set tabIndex(value:int):void
    function get title():String
    function set title(value:String):void
    function get translate():Boolean
    function set translate(value:Boolean):void
    function get virtualKeyboardPolicy():String
    function set virtualKeyboardPolicy(value:String):void
    function get writingSuggestions():String
    function set writingSuggestions(value:String):void

    // ---- layout ----
    function get offsetHeight():Float
    function get offsetLeft():Float
    function get offsetParent():Element?
    function get offsetTop():Float
    function get offsetWidth():Float

    // ---- interaction ----
    function attachInternals():*
    function blur():void
    function click():void
    function focus():void
    function focus(options:{ ?preventScroll:Boolean, ?focusVisible:Boolean }):void
    function hidePopover():void
    function showPopover():void
    function showPopover(options:{ ?source:HTMLElement }):void
    function togglePopover():Boolean
    function togglePopover(force:Boolean):Boolean
    function togglePopover(options:{ ?force:Boolean, ?source:HTMLElement }):Boolean
  }
}
