// Browser: an HTML element. More specific HTML element classes inherit from this common interface.
package xenon {
  /** An element's `data-*` attributes (`element.dataset`): names to values, every value a `String`. */
  public typedef DOMStringMap = Record<String, String>

  public native class HTMLElement extends Element {
    private function HTMLElement()

    // ---- global HTML attributes ----
    var accessKey:String
    final accessKeyLabel:String
    final anchorElement:Element?
    /** Typed CSS declarations from the `style` attribute. */
    final attributeStyleMap:*
    /** The live inline styles. Assigning a `String` replaces `cssText`. */
    public override function get style():CSSStyleProperties
    /** `el.style = 'color: red'`: replaces all inline styles (the `style` attribute). */
    public override function set style(cssText:String):void
    var autocapitalize:String
    var autocorrect:Boolean
    var autofocus:Boolean
    var containerTiming:String
    var containerTimingIgnore:Boolean
    var contentEditable:String
    /**
     * The `data-*` attributes by their camel-cased names: `data-user-id` is `dataset.userId` (or
     * `dataset['userId']`). Reading gives `String?` (missing: `null`); writing sets the attribute.
     */
    final dataset:DOMStringMap
    var dir:String
    var draggable:Boolean
    var editContext:*
    var enterKeyHint:String
    var hidden:Boolean | String
    var inert:Boolean
    var innerText:String
    var inputMode:String
    final isContentEditable:Boolean
    var lang:String
    var nonce:String
    var outerText:String
    var popover:String?
    var spellcheck:Boolean
    var tabIndex:int
    var title:String
    var translate:Boolean
    var virtualKeyboardPolicy:String
    var writingSuggestions:String

    // ---- layout ----
    final offsetHeight:Float
    final offsetLeft:Float
    final offsetParent:Element?
    final offsetTop:Float
    final offsetWidth:Float

    // ---- interaction ----
    function attachInternals():*
    function blur():void
    function click():void
    function focus():void
    function focus(options:{ ?preventScroll:Boolean, ?focusVisible:Boolean }):void
    function hidePopover():void
    function showPopover():void
    function showPopover(options:{ ?source:HTMLElement }):void
    function togglePopover():Boolean
    function togglePopover(force:Boolean):Boolean
    function togglePopover(options:{ ?force:Boolean, ?source:HTMLElement }):Boolean
  }
}
