// Browser: the DOM's `Element`, a tag in an HTML or XML document (`<w:p>` in a Word file's XML too).
// Browser-only: Bun has no DOM, so `Element` exists at runtime only in a browser (or with a DOM
// library such as happy-dom); `x is Element` in Bun throws a `ReferenceError`.
//
// Typing: a missing attribute is `null` (`getAttribute` returns `String?`); lookups that may find
// nothing are `T?` (`querySelector`, `closest`). `getElementsByTagName` & co. return a live
// `HTMLCollection`; `querySelectorAll` a static `NodeList<Element>`. Both work with `for … of` and
// `Array.from`. CSS classes and inline style remain dynamic; HTML-specific APIs live on
// `HTMLElement`.
package xenon {
  public native class Element extends Node {
    private function Element()

    // ---- names ----
    /** The qualified name as written (`'w:p'`; upper case for HTML elements in an HTML document). */
    final tagName:String
    /** The name without the prefix: `'p'` for `<w:p>`. */
    final localName:String
    /** The prefix: `'w'` for `<w:p>`, else `null`. */
    final prefix:String?
    final namespaceURI:String?
    var id:String
    var className:String
    /** The class names as a `DOMTokenList` (`add`, `remove`, `toggle`, `contains`). */
    /** The CSS classes (`add`, `remove`, `toggle`, `contains`); assigning a `String` replaces the `class` attribute. */
    function get classList():DOMTokenList
    function set classList(value:String):Void
    /** Inline CSS properties; dynamic because CSSStyleDeclaration has hundreds of properties. */
    function get style():*

    // ---- attributes ----
    final attributes:NamedNodeMap
    function hasAttributes():Bool
    function getAttributeNames():Array<String>
    /** The attribute's value, or `null` if the element doesn't have it: `br.getAttribute('w:type')`. */
    function getAttribute(name:String):String?
    function getAttributeNS(ns:String?, localName:String):String?
    function hasAttribute(name:String):Bool
    function hasAttributeNS(ns:String?, localName:String):Bool
    function setAttribute(name:String, value:String):Void
    function setAttributeNS(ns:String?, qualifiedName:String, value:String):Void
    function removeAttribute(name:String):Void
    function removeAttributeNS(ns:String?, localName:String):Void
    /** Adds the attribute if it's missing, removes it if present (or as `force` says); whether it's there now. */
    function toggleAttribute(name:String):Bool
    function toggleAttribute(name:String, force:Bool):Bool

    // ---- finding elements ----
    /** All descendants with this qualified name (`'w:br'`, `'*'` for all), live. */
    function getElementsByTagName(qualifiedName:String):HTMLCollection
    function getElementsByTagNameNS(ns:String?, localName:String):HTMLCollection
    function getElementsByClassName(classNames:String):HTMLCollection
    /** The first descendant matching a CSS selector, or `null`. */
    function querySelector(selectors:String):Element?
    function querySelectorAll(selectors:String):NodeList<Element>
    /** The element itself or its nearest ancestor matching the selector, or `null`. */
    function closest(selectors:String):Element?
    function matches(selectors:String):Bool

    // ---- children and siblings that are elements ----
    final children:HTMLCollection
    final firstElementChild:Element?
    final lastElementChild:Element?
    final childElementCount:Int
    final previousElementSibling:Element?
    final nextElementSibling:Element?

    // ---- changing the tree (nodes or strings, which become text) ----
    function append(...nodes:Array<*>):Void
    function prepend(...nodes:Array<*>):Void
    function replaceChildren(...nodes:Array<*>):Void
    function before(...nodes:Array<*>):Void
    function after(...nodes:Array<*>):Void
    function replaceWith(...nodes:Array<*>):Void
    /** Takes the element out of its parent. */
    function remove():Void
    /** `where`: `'beforebegin'`, `'afterbegin'`, `'beforeend'` or `'afterend'`. */
    function insertAdjacentElement(where:String, element:Element):Element?
    function insertAdjacentText(where:String, text:String):Void
    function insertAdjacentHTML(where:String, html:String):Void

    /** The element's text, or `''` when it has no text. */
    public override function get textContent():String
    public override function set textContent(value:String?):Void

    // ---- shadow DOM ----
    /** Gives the element a shadow tree (once): `attachShadow({ mode: 'open' })`. */
    function attachShadow(init:{ mode:String, ?delegatesFocus:Bool, ?slotAssignment:String }):ShadowRoot
    /** The open shadow root, or `null` (none, or a closed one). */
    final shadowRoot:ShadowRoot?
    var slot:String

    // ---- markup ----
    /** The children as HTML or XML text; setting it parses and replaces them. */
    var innerHTML:String
    /** The element itself and its children as text. */
    var outerHTML:String
  }
}
