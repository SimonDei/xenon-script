// Part of Xenon. GPL-3.0-or-later with the Xenon Runtime Exception (see LICENSE): the compiled
// prelude in programs built with Xenon may be distributed under any terms.
// Standard library: `int` (alias `Int`), 32-bit signed integers. At runtime they're JavaScript
// numbers, so the members are `Float`'s (`toFixed`, `toString(radix)`, …) with whole-number
// results where JavaScript guarantees one. The range constants are `inline`: compile-time
// literals, since JavaScript has no object holding them. See also `uint.xn`.
package xenon {
  /** Capitalized alias of `int`, for code that names all types in upper case. */
  public typedef Int = int

  public native('Number') class int extends Float {
    private function int()

    /** The value itself, still an `int`. */
    override function valueOf():int

    /** 2147483647 (2^31 − 1), the largest `int`. */
    public static inline const MAX_VALUE:int = 2147483647
    /** −2147483648 (−2^31), the smallest `int`. */
    public static inline const MIN_VALUE:int = -2147483648
  }
}
