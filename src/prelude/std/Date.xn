// Standard library: JavaScript's `Date`.
//
// Time values are milliseconds since 1970-01-01 UTC as `Float` (they exceed the `int` range).
// Months count from 0 (January) to 11, as in JavaScript; `getDay()` is 0 (Sunday) to 6.
// Typing: getters are `int` as long as the date is valid. An invalid date (`new Date('x')`,
// `new Date(NaN)`) makes them return NaN at runtime: check `isNaN(d.getTime())` first when the
// input isn't trusted. Setters return the new time value.
// Not declared (deprecated): `getYear`, `setYear`, `toGMTString`.
package xenon {
  public native class Date {
    /** The current date and time. */
    function Date()
    /** From milliseconds since 1970-01-01 UTC. */
    function Date(time:Float)
    /** Parses `text` like `Date.parse` (ISO 8601 such as `'2024-02-29T12:00:00Z'`); invalid text gives an invalid date. */
    function Date(text:String)
    /** A copy of another date. */
    function Date(date:Date)
    /** From local-time parts; `month` is 0–11. */
    function Date(year:Int, month:Int, day:Int = 1, hours:Int = 0, minutes:Int = 0, seconds:Int = 0, milliseconds:Int = 0)

    /** Milliseconds since 1970-01-01 UTC, for the current moment. */
    static function now():Float
    /** Milliseconds for a date string, or NaN if it isn't valid. */
    static function parse(text:String):Float
    /** Milliseconds for UTC parts; `month` is 0–11. */
    static function UTC(year:Int, month:Int = 0, day:Int = 1, hours:Int = 0, minutes:Int = 0, seconds:Int = 0, milliseconds:Int = 0):Float

    // ---- reading (local time) ----
    /** Year, e.g. 2024 */
    function getFullYear():Int const
    /** 0–11 */
    function getMonth():Int const
    /** Day of the month, 1–31 */
    function getDate():Int const
    /** Day of the week, 0 (Sunday) – 6 */
    function getDay():Int const
    /** 0–23 */
    function getHours():Int const
    /** 0–59 */
    function getMinutes():Int const
    /** 0–59 */
    function getSeconds():Int const
    /** 0–999 */
    function getMilliseconds():Int const
    /** Milliseconds since 1970-01-01 UTC. */
    function getTime():Float const
    /** Same as `getTime()`. */
    function valueOf():Float const
    /** Minutes UTC is ahead of local time (negative east of Greenwich). */
    function getTimezoneOffset():Int const

    // ---- reading (UTC) ----
    function getUTCFullYear():Int const
    function getUTCMonth():Int const
    function getUTCDate():Int const
    function getUTCDay():Int const
    function getUTCHours():Int const
    function getUTCMinutes():Int const
    function getUTCSeconds():Int const
    function getUTCMilliseconds():Int const

    // ---- writing: each returns the new time value; omitted trailing parts stay as they are ----
    function setTime(time:Float):Float
    function setFullYear(year:Int):Float
    function setFullYear(year:Int, month:Int):Float
    function setFullYear(year:Int, month:Int, day:Int):Float
    function setMonth(month:Int):Float
    function setMonth(month:Int, day:Int):Float
    function setDate(day:Int):Float
    function setHours(hours:Int):Float
    function setHours(hours:Int, minutes:Int):Float
    function setHours(hours:Int, minutes:Int, seconds:Int):Float
    function setHours(hours:Int, minutes:Int, seconds:Int, milliseconds:Int):Float
    function setMinutes(minutes:Int):Float
    function setMinutes(minutes:Int, seconds:Int):Float
    function setMinutes(minutes:Int, seconds:Int, milliseconds:Int):Float
    function setSeconds(seconds:Int):Float
    function setSeconds(seconds:Int, milliseconds:Int):Float
    function setMilliseconds(milliseconds:Int):Float
    function setUTCFullYear(year:Int):Float
    function setUTCFullYear(year:Int, month:Int):Float
    function setUTCFullYear(year:Int, month:Int, day:Int):Float
    function setUTCMonth(month:Int):Float
    function setUTCMonth(month:Int, day:Int):Float
    function setUTCDate(day:Int):Float
    function setUTCHours(hours:Int):Float
    function setUTCHours(hours:Int, minutes:Int):Float
    function setUTCHours(hours:Int, minutes:Int, seconds:Int):Float
    function setUTCHours(hours:Int, minutes:Int, seconds:Int, milliseconds:Int):Float
    function setUTCMinutes(minutes:Int):Float
    function setUTCMinutes(minutes:Int, seconds:Int):Float
    function setUTCMinutes(minutes:Int, seconds:Int, milliseconds:Int):Float
    function setUTCSeconds(seconds:Int):Float
    function setUTCSeconds(seconds:Int, milliseconds:Int):Float
    function setUTCMilliseconds(milliseconds:Int):Float

    // ---- formatting ----
    /** `'2024-02-29T12:00:00.000Z'`; throws a `RangeError` (caught as `RangeException`) for an invalid date. */
    function toISOString():String const
    /** Like `toISOString()`, but `null` for an invalid date (what `JSON.stringify` uses). */
    function toJSON(key:String = ''):String? const
    /** `'Thu Feb 29 2024 13:00:00 GMT+0100 (Central European Standard Time)'` */
    function toString():String const
    /** `'Thu Feb 29 2024'` */
    function toDateString():String const
    /** `'13:00:00 GMT+0100 (Central European Standard Time)'` */
    function toTimeString():String const
    /** `'Thu, 29 Feb 2024 12:00:00 GMT'` */
    function toUTCString():String const

    /** Date and time for the default locale. */
    function toLocaleString():String const
    /** For a locale tag like `'de-DE'`; `options` are `Intl.DateTimeFormat` options. */
    function toLocaleString(locale:String, options:* = null):String const
    function toLocaleString(locales:Array<String>, options:* = null):String const
    function toLocaleDateString():String const
    function toLocaleDateString(locale:String, options:* = null):String const
    function toLocaleDateString(locales:Array<String>, options:* = null):String const
    function toLocaleTimeString():String const
    function toLocaleTimeString(locale:String, options:* = null):String const
    function toLocaleTimeString(locales:Array<String>, options:* = null):String const
  }
}
