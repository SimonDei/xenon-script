// Standard library: members of numbers (JavaScript `Number`). `int` and `uint` values have the
// same members as `Float`. Conversions are written `Float(x)`, `int(x)` and `uint(x)`, never
// `new`: the constructor would create a wrapper object, so it is hidden.
//
// Typing: results that can be NaN or exceed the `int` range are `Float` (`parseInt`,
// `MAX_SAFE_INTEGER`); the `is…` tests accept any value, as in JavaScript.
package klass {
  public native('Number') class Float {
    private function Float()

    /** Digits in base `radix` (2–36): `(255).toString(16)` is `'ff'`. */
    function toString(radix:int = 10):String
    /** Fixed-point notation with `digits` (0–100) after the point, rounded: `(1.005).toFixed(2)`. */
    function toFixed(digits:int = 0):String
    /** Exponential notation with as many digits as needed: `(1234).toExponential()` is `'1.234e+3'`. */
    function toExponential():String
    /** Exponential notation with `digits` (0–100) after the point. */
    function toExponential(digits:int):String
    /** Same as `toString()`. */
    function toPrecision():String
    /** `precision` (1–100) significant digits, in fixed or exponential notation. */
    function toPrecision(precision:int):String
    /** Formatted for the default locale, e.g. `'1,234.5'`. */
    function toLocaleString():String
    /** Formatted for a locale tag like `'de-DE'`; `options` are `Intl.NumberFormat` options. */
    function toLocaleString(locale:String, options:* = null):String
    /** Formatted for the first supported locale in the list. */
    function toLocaleString(locales:Vector<String>, options:* = null):String
    /** The number itself. */
    function valueOf():Float

    /** Difference between 1 and the next larger representable number (about 2.2e-16). */
    static const EPSILON:Float
    /** Largest integer n where n and n + 1 are exact (2^53 − 1). Exceeds the `int` range. */
    static const MAX_SAFE_INTEGER:Float
    /** −(2^53 − 1). */
    static const MIN_SAFE_INTEGER:Float
    /** Largest finite number (about 1.8e308). */
    static const MAX_VALUE:Float
    /** Smallest positive number (about 5e-324). */
    static const MIN_VALUE:Float
    /** Not-a-number. Test with `Float.isNaN(x)`: `NaN == NaN` is false. */
    static const NaN:Float
    static const POSITIVE_INFINITY:Float
    static const NEGATIVE_INFINITY:Float

    /** Is `value` a number other than NaN and ±Infinity? (No conversion: `isFinite('1')` is false.) */
    static function isFinite(value:*):Boolean
    /** Is `value` a whole number? (`2.0` is, `'2'` isn't.) */
    static function isInteger(value:*):Boolean
    /** Is `value` NaN? (No conversion: `isNaN('x')` is false.) */
    static function isNaN(value:*):Boolean
    /** Is `value` a whole number between `MIN_SAFE_INTEGER` and `MAX_SAFE_INTEGER`? */
    static function isSafeInteger(value:*):Boolean
    /** Leading number in `text` (`'3.5kg'` → 3.5), or NaN. */
    static function parseFloat(text:String):Float
    /** Leading integer in `text` in base `radix` (`'ff'`, 16 → 255), or NaN. */
    static function parseInt(text:String, radix:int = 10):Float
  }
}
