// Standard library: JavaScript's `ArrayBuffer`: a block of raw bytes, e.g. from
// `await res.arrayBuffer()` or `Bun.file(path).arrayBuffer()`. It has no way to read or write
// the bytes itself: that goes through a view on it (`new Uint8Array(buffer)`, `new DataView(buffer)`,
// not typed yet: use them as `*`).
//
// A buffer is fixed-size, or resizable up to a maximum: `new ArrayBuffer(8, { maxByteLength: 64 })`.
// `transfer` moves the bytes into a new buffer and leaves this one detached (`byteLength` 0).
package xenon {
  public native class ArrayBuffer {
    /** `length` zero bytes. */
    function ArrayBuffer(length:Int)
    /** A resizable buffer: `length` bytes now, up to `maxByteLength` with `resize`. */
    function ArrayBuffer(length:Int, options:{ maxByteLength:Int })

    /** Is `value` a view on a buffer (a typed array such as `Uint8Array`, or a `DataView`)? */
    static function isView(value:*):Bool

    /** The size in bytes (0 once detached). */
    final byteLength:Int
    /** The largest size `resize` allows (`byteLength` for a fixed-size buffer). */
    final maxByteLength:Int
    final resizable:Bool
    /** Has `transfer` moved the bytes out? A detached buffer can't be used. */
    final detached:Bool

    /** A copy of the bytes from `start` up to (not including) `end`; negative positions count from the end. */
    function slice():ArrayBuffer const
    function slice(start:Int):ArrayBuffer const
    function slice(start:Int, end:Int):ArrayBuffer const
    /** Changes the size of a resizable buffer (new bytes are zero); throws a `RangeException` beyond `maxByteLength`. */
    function resize(newLength:Int):Void
    /** Moves the bytes into a new buffer (of `newLength` bytes, cut or zero-filled), detaching this one; keeps resizability. */
    function transfer():ArrayBuffer
    function transfer(newLength:Int):ArrayBuffer
    /** Like `transfer`, but the new buffer is fixed-size. */
    function transferToFixedLength():ArrayBuffer
    function transferToFixedLength(newLength:Int):ArrayBuffer
  }
}
