# dependencies (bun install)
node_modules/

# build output (xenon build writes `out/` plus its manifest `out/.xenon-outputs`)
/out/
examples/*/out/
/dist/
*.tgz
*.vsix

# test scratch directories (created and removed by the tests; left behind if a run is aborted)
examples/*/.test-out/
tests/.prelude-out/
tests/.watch-project/
tests/.sourcemap-project/
tests/.build-project/

# code coverage
coverage/
*.lcov

# logs
logs/
*.log
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# dotenv environment variable files
.env
.env.*
!.env.example

# caches
.eslintcache
.cache/
*.tsbuildinfo

# editors (shared VS Code settings can be added with `!.vscode/<file>`)
.vscode/
.idea/
*.swp
*~

# OS files
.DS_Store
Thumbs.db
